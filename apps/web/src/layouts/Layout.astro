---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { useI18n } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Override lang if needed (rare — locale detection usually handles it). */
  lang?: string;
  type?: "website" | "music.album" | "music.musician" | "article";
  noindex?: boolean;
}

const { title, description, ogImage, lang, type, noindex } = Astro.props;
const { meta } = useI18n(Astro);
const htmlLang = lang ?? meta.htmlLang;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
    />
    <GoogleAnalytics />
  </head>
  <body>
    <slot />
  </body>
</html>
