---
// Standalone "Agent UI — A design system for corporate AI agents" deck.
// Lives at /agent-design-system. Same pattern as /design-system-demo and
// /tcoach: raw HTML pass-through via Vite's ?raw import + Response, with
// GA injection applied at request time so the route is tracked alongside
// every other page on the site.
import demoHtml from "../_static/agent-design-system.html?raw";
import { injectGA } from "../lib/inject-ga";

return new Response(injectGA(demoHtml), {
  headers: {
    "content-type": "text/html; charset=utf-8",
    "cache-control": "public, max-age=300",
  },
});
---
