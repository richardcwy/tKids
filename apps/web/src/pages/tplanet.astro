---
// Standalone teaser landing for tPlanet, the third pillar of the t-universe.
// Lives at /tplanet. Like /tgirls, this deliberately bypasses Layout.astro —
// no shared cosmic chrome, no nav/footer, no ShootingStars. The dark/neon
// palette and crosshair cursor are page-scoped via is:global so they don't
// leak to other routes.
//
// All fonts are already self-hosted for the main site. No new @fontsource
// installs required.
import "@fontsource/unbounded/300.css";
import "@fontsource/unbounded/400.css";
import "@fontsource/unbounded/600.css";
import "@fontsource/unbounded/700.css";
import "@fontsource/unbounded/800.css";
import "@fontsource/unbounded/900.css";
import "@fontsource/fraunces/400-italic.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/600-italic.css";
import "@fontsource/jetbrains-mono/300.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/noto-sans-tc/300.css";
import "@fontsource/noto-sans-tc/400.css";
import "@fontsource/noto-sans-tc/500.css";
import "@fontsource/noto-sans-tc/700.css";

const ogImage = "/og-default.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>tPlanet — Coming this fall</title>
    <meta
      name="description"
      content="tPlanet — your home in the t-universe. Coming Fall 2026."
    />
    <meta property="og:title" content="tPlanet — Coming this fall" />
    <meta
      property="og:description"
      content="tPlanet — your home in the t-universe. Coming Fall 2026."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tkids.tw/tplanet" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://tkids.tw/tplanet" />
  </head>
  <body>
    <div class="bg-atmosphere"></div>
    <div class="star-field" id="starField" aria-hidden="true"></div>

    <section class="hero">
      <div class="hero-left">
        <div class="hero-tag">
          <span class="ht-dot" aria-hidden="true"></span>
          vip · t-universe
        </div>

        <h1 class="wordmark hero-wordmark">
          <span>t</span>
          <span class="wm-orb" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="orbHeroG" cx="35%" cy="30%">
                  <stop offset="0%" stop-color="#86ffc4"></stop>
                  <stop offset="40%" stop-color="#a855f7"></stop>
                  <stop offset="100%" stop-color="#06060f"></stop>
                </radialGradient>
              </defs>
              <circle cx="12" cy="12" r="10" fill="url(#orbHeroG)"></circle>
              <circle
                cx="12"
                cy="12"
                r="10"
                fill="none"
                stroke="#22ee99"
                stroke-width="0.7"
                opacity="0.8"
              ></circle>
            </svg>
          </span>
          <span>Planet</span>
        </h1>

        <p class="slogan-en">Your home in the <em>t-universe</em></p>
        <p class="slogan-zh" lang="zh-TW">
          你在 t 宇宙的<span class="accent">家</span> · 認領、守候、擴張
        </p>

        <div class="signal-counter">
          <span class="sc-label">▸ signals</span>
          <span class="sc-value" id="signalValue">0</span>
        </div>

        <div class="coming-soon">
          <span class="cs-dot" aria-hidden="true"></span>
          Coming · <b>Fall 2026</b> · 今秋登陸
        </div>
      </div>

      <div class="hero-right">
        <div class="planet-stage" id="planetStage">
          <div class="planet-aura" aria-hidden="true"></div>

          <button
            class="planet-hero"
            id="planetHero"
            aria-label="tap the planet"
          ></button>

          <div class="surface" aria-hidden="true">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <clipPath id="planetClip"
                  ><circle cx="100" cy="100" r="100"></circle></clipPath
                >
              </defs>
              <g clip-path="url(#planetClip)">
                <path
                  d="M30 60 Q50 45 75 55 Q90 70 80 88 Q60 95 40 85 Q25 78 30 60 Z"
                  fill="#22ee99"
                  opacity="0.55"
                ></path>
                <path
                  d="M120 130 Q145 120 165 135 Q170 155 150 165 Q125 168 115 150 Q110 138 120 130 Z"
                  fill="#c084fc"
                  opacity="0.6"
                ></path>
                <ellipse
                  cx="155"
                  cy="75"
                  rx="14"
                  ry="9"
                  fill="#86ffc4"
                  opacity="0.55"
                ></ellipse>
                <path
                  d="M50 110 Q80 115 110 105 Q140 95 165 110"
                  stroke="#22ee99"
                  stroke-width="1.5"
                  fill="none"
                  opacity="0.6"
                  stroke-dasharray="3 4"
                ></path>
                <g fill="#d4d8e3">
                  <circle cx="55" cy="72" r="1.4"></circle>
                  <circle cx="62" cy="78" r="1.1"></circle>
                  <circle cx="48" cy="80" r="1"></circle>
                  <circle cx="142" cy="148" r="1.4"></circle>
                  <circle cx="148" cy="152" r="1"></circle>
                  <circle cx="135" cy="158" r="1.2"></circle>
                </g>
                <g transform="translate(75 65)">
                  <circle
                    r="3"
                    fill="none"
                    stroke="#22ee99"
                    stroke-width="0.6"
                    opacity="0.7"
                  ></circle>
                  <circle r="1.2" fill="#22ee99"></circle>
                </g>
              </g>
            </svg>
          </div>

          <div class="planet-scan" aria-hidden="true"></div>

          <div class="orbit-ring orbit-1" aria-hidden="true">
            <div class="moonlet"></div>
          </div>
          <div class="orbit-ring orbit-2" aria-hidden="true">
            <div class="moonlet"></div>
          </div>
          <div class="orbit-ring orbit-3" aria-hidden="true">
            <div class="moonlet"></div>
          </div>

          <div class="planet-sparkles" id="planetSparkles" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <div class="ground">
      Part of the <a href="https://tkids.tw" rel="noopener">tKids</a> universe ·
      與 tKids、tGirls 同屬 t 宇宙
    </div>

    <script is:inline>
      // Font-loading gate so the hero arrives intentionally rather than popping.
      (function gateOnFonts() {
        const html = document.documentElement;
        let settled = false;
        const reveal = (cls) => {
          if (!settled) {
            settled = true;
            html.classList.add(cls);
          }
        };
        if (document.fonts && document.fonts.ready) {
          Promise.race([
            document.fonts.ready.then(() => "ready"),
            new Promise((r) => setTimeout(() => r("late"), 1200)),
          ]).then((result) =>
            reveal(result === "ready" ? "fonts-ready" : "fonts-late"),
          );
        } else {
          window.addEventListener("load", () => reveal("fonts-late"));
          setTimeout(() => reveal("fonts-late"), 300);
        }
      })();

      // Background twinkling stars — count scaled to viewport area.
      const starField = document.getElementById("starField");
      function buildStarField() {
        starField.innerHTML = "";
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const count = Math.max(40, Math.min(80, Math.round((vw * vh) / 18000)));
        for (let i = 0; i < count; i++) {
          const s = document.createElement("div");
          s.className = "twinkle";
          const r = Math.random();
          if (r < 0.15) s.classList.add("purple");
          else if (r < 0.28) s.classList.add("green");
          const size = 4 + Math.random() * 12;
          s.style.width = size + "px";
          s.style.height = size + "px";
          s.style.left = Math.random() * vw + "px";
          s.style.top = Math.random() * vh + "px";
          s.style.setProperty("--dur", 2.2 + Math.random() * 3 + "s");
          s.style.setProperty("--delay", Math.random() * 3 + "s");
          if (Math.random() < 0.6) {
            s.innerHTML =
              '<svg viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>';
          } else {
            s.innerHTML =
              '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/></svg>';
          }
          starField.appendChild(s);
        }
      }
      buildStarField();

      // Sparkles orbiting the planet stage.
      const planetSparkles = document.getElementById("planetSparkles");
      function buildPlanetSparkles() {
        planetSparkles.innerHTML = "";
        const count = 16;
        for (let i = 0; i < count; i++) {
          const s = document.createElement("div");
          s.className = "sparkle";
          const r = Math.random();
          if (r < 0.35) s.classList.add("purple");
          else if (r < 0.5) s.classList.add("chrome");
          const size = 6 + Math.random() * 10;
          s.style.width = size + "px";
          s.style.height = size + "px";
          s.style.left = Math.random() * 100 + "%";
          s.style.top = Math.random() * 100 + "%";
          s.style.setProperty("--dur", 2.2 + Math.random() * 2 + "s");
          s.style.setProperty("--delay", Math.random() * 3 + "s");
          s.innerHTML =
            '<svg viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>';
          planetSparkles.appendChild(s);
        }
      }
      buildPlanetSparkles();

      let resizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(buildStarField, 200);
      });

      // Tap-the-planet cookie-clicker tease.
      const planet = document.getElementById("planetHero");
      const planetStage = document.getElementById("planetStage");
      const signalValue = document.getElementById("signalValue");
      let signals = 0;

      planet.addEventListener("click", (e) => {
        signals += 1;
        signalValue.textContent = signals.toLocaleString();
        signalValue.classList.add("bumped");
        setTimeout(() => signalValue.classList.remove("bumped"), 180);

        const rect = planetStage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const ripple = document.createElement("div");
        ripple.className = "ripple";
        ripple.style.left = x + "px";
        ripple.style.top = y + "px";
        ripple.style.transform = "translate(-50%, -50%)";
        planetStage.appendChild(ripple);
        ripple.addEventListener("animationend", () => ripple.remove());

        const pop = document.createElement("div");
        pop.className = "pop";
        pop.textContent = "+1";
        pop.style.left = x + "px";
        pop.style.top = y + "px";
        planetStage.appendChild(pop);
        pop.addEventListener("animationend", () => pop.remove());
      });

      // Pause CSS animations when hidden so a backgrounded tab doesn't burn
      // cycles + so animations don't pile up on refocus.
      document.addEventListener("visibilitychange", () => {
        const playState =
          document.visibilityState === "visible" ? "running" : "paused";
        document
          .querySelectorAll(
            ".twinkle, .sparkle, .planet-aura, .surface, .orbit-ring",
          )
          .forEach((el) => {
            el.style.animationPlayState = playState;
          });
      });
    </script>

    <style is:global>
      :root {
        --void: #06060f;
        --onyx: #11111c;
        --carbon: #1a1a2a;
        --purple: #a855f7;
        --purple-bright: #c084fc;
        --purple-deep: #6b21d6;
        --purple-glow: rgba(168, 85, 247, 0.5);
        --green: #22ee99;
        --green-bright: #86ffc4;
        --green-deep: #0a9a6a;
        --green-glow: rgba(34, 238, 153, 0.5);
        --chrome: #d4d8e3;
        --chrome-warm: #e8eaf2;
        --steel: #7d8499;
        --graphite: #4a4f63;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      /* Page-scoped sci-fi crosshair cursor (overrides the site's gold-star
         cursor — only applies on /tplanet because we don't import global.css). */
      html,
      body {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><g stroke='%2322ee99' stroke-width='1' opacity='0.9' fill='none'><circle cx='16' cy='16' r='8'/><line x1='16' y1='2' x2='16' y2='8'/><line x1='16' y1='24' x2='16' y2='30'/><line x1='2' y1='16' x2='8' y2='16'/><line x1='24' y1='16' x2='30' y2='16'/></g><circle cx='16' cy='16' r='2.5' fill='%23a855f7'/></svg>")
          16 16, auto;
      }
      a,
      button,
      [role="button"],
      .planet-hero {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><g stroke='%2322ee99' stroke-width='1.4' fill='none'><circle cx='20' cy='20' r='10'/><circle cx='20' cy='20' r='14' opacity='0.5'/><line x1='20' y1='2' x2='20' y2='8'/><line x1='20' y1='32' x2='20' y2='38'/><line x1='2' y1='20' x2='8' y2='20'/><line x1='32' y1='20' x2='38' y2='20'/></g><circle cx='20' cy='20' r='3.5' fill='%23a855f7'/></svg>")
          20 20, pointer;
      }

      body {
        background: var(--void);
        color: var(--chrome);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .bg-atmosphere {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 1200px 800px at 75% 35%, rgba(168, 85, 247, 0.28) 0%, transparent 55%),
          radial-gradient(ellipse 800px 600px at 15% 75%, rgba(34, 238, 153, 0.14) 0%, transparent 55%),
          radial-gradient(ellipse 600px 500px at 50% 0%, rgba(107, 33, 214, 0.3) 0%, transparent 60%),
          linear-gradient(180deg, var(--void) 0%, #03030a 100%);
      }
      .bg-atmosphere::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(168, 85, 247, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(168, 85, 247, 0.05) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(
          ellipse at center,
          black 0%,
          transparent 70%
        );
      }
      .bg-atmosphere::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.08;
        mix-blend-mode: overlay;
      }

      /* twinkling background stars */
      .star-field {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
      }
      .twinkle {
        position: absolute;
        color: var(--chrome);
        will-change: opacity;
        animation: twinkle var(--dur, 3s) ease-in-out infinite;
        animation-delay: var(--delay, 0s);
      }
      .twinkle.purple {
        color: var(--purple);
      }
      .twinkle.green {
        color: var(--green);
      }
      .twinkle svg {
        width: 100%;
        height: 100%;
        fill: currentColor;
      }
      @keyframes twinkle {
        0%,
        100% {
          opacity: 0.15;
          transform: scale(0.8);
        }
        50% {
          opacity: 0.85;
          transform: scale(1.05);
          filter: drop-shadow(0 0 4px currentColor);
        }
      }

      /* wordmark */
      .wordmark {
        display: inline-flex;
        align-items: center;
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 0.85;
        color: inherit;
        white-space: nowrap;
      }
      .wordmark > span {
        display: inline-block;
      }
      .wordmark .wm-orb {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 0.7em;
        height: 0.7em;
        margin: 0 0.04em;
        flex-shrink: 0;
        transform: translateY(-0.04em);
        animation: orbSpin 18s linear infinite;
      }
      .wordmark .wm-orb svg {
        width: 100%;
        height: 100%;
        display: block;
      }
      @keyframes orbSpin {
        from {
          transform: translateY(-0.04em) rotate(0deg);
        }
        to {
          transform: translateY(-0.04em) rotate(360deg);
        }
      }

      /* hero */
      .hero {
        position: relative;
        z-index: 3;
        width: 100%;
        height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        padding: 60px 60px 80px;
        gap: 40px;
      }
      .hero-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: rgba(168, 85, 247, 0.08);
        border: 1px solid rgba(168, 85, 247, 0.4);
        border-radius: 4px;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--green);
        margin-bottom: 24px;
      }
      .hero-tag .ht-dot {
        width: 6px;
        height: 6px;
        background: var(--green);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--green);
        animation: pulse 1.6s ease-in-out infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.4;
          transform: scale(1.3);
        }
      }
      .hero-wordmark {
        font-size: clamp(80px, 11vw, 160px);
        color: var(--chrome);
        margin-bottom: 24px;
        text-shadow:
          0 0 40px rgba(168, 85, 247, 0.55),
          0 0 100px rgba(34, 238, 153, 0.2);
      }
      .slogan-en {
        font-family: "Fraunces", serif;
        font-style: italic;
        font-weight: 600;
        font-size: clamp(22px, 2.4vw, 32px);
        color: var(--chrome);
        line-height: 1.2;
        margin-bottom: 12px;
        letter-spacing: -0.005em;
      }
      .slogan-en em {
        font-family: "Unbounded", sans-serif;
        font-style: normal;
        font-weight: 700;
        color: var(--green);
        font-size: 0.85em;
        letter-spacing: -0.02em;
        text-shadow: 0 0 20px var(--green-glow);
      }
      .slogan-zh {
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 400;
        font-size: clamp(13px, 1.05vw, 15px);
        color: var(--steel);
        letter-spacing: 0.16em;
        line-height: 1.6;
        margin-bottom: 36px;
      }
      .slogan-zh .accent {
        color: var(--green);
        font-weight: 500;
      }

      /* signal counter */
      .signal-counter {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        background: var(--void);
        border: 1px solid rgba(34, 238, 153, 0.3);
        border-radius: 6px;
        margin-bottom: 24px;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--steel);
        position: relative;
        overflow: hidden;
      }
      .signal-counter::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--green), transparent);
        animation: scanLine 3s ease-in-out infinite;
      }
      @keyframes scanLine {
        0%,
        100% {
          opacity: 0.3;
        }
        50% {
          opacity: 1;
        }
      }
      .signal-counter .sc-label {
        color: var(--green);
      }
      .signal-counter .sc-value {
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        font-size: 18px;
        color: var(--chrome);
        letter-spacing: -0.02em;
        text-transform: none;
        font-variant-numeric: tabular-nums;
        transition:
          color 0.15s,
          transform 0.15s;
      }
      .signal-counter .sc-value.bumped {
        color: var(--green);
        transform: scale(1.15);
      }

      .coming-soon {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 11px 22px;
        border: 1px solid var(--purple);
        border-radius: 6px;
        background: rgba(168, 85, 247, 0.1);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.28em;
        color: var(--chrome);
      }
      .coming-soon .cs-dot {
        width: 7px;
        height: 7px;
        background: var(--purple);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--purple);
        animation: pulse 1.6s ease-in-out infinite;
      }
      .coming-soon b {
        font-family: "Unbounded", sans-serif;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: -0.01em;
        text-transform: none;
        color: var(--green);
        margin: 0 2px;
      }

      /* ============== PLANET ============== */
      .hero-right {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .planet-stage {
        position: relative;
        width: clamp(360px, 44vw, 580px);
        aspect-ratio: 1;
      }
      .planet-aura {
        position: absolute;
        inset: -8%;
        border-radius: 50%;
        background: radial-gradient(
          circle at center,
          transparent 50%,
          rgba(34, 238, 153, 0.18) 56%,
          rgba(168, 85, 247, 0.28) 65%,
          transparent 80%
        );
        filter: blur(14px);
        animation: auraBreath 6s ease-in-out infinite;
      }
      @keyframes auraBreath {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.85;
        }
        50% {
          transform: scale(1.06);
          opacity: 1;
        }
      }
      .planet-hero {
        position: absolute;
        inset: 8%;
        border-radius: 50%;
        background:
          radial-gradient(ellipse at 25% 30%, rgba(255, 255, 255, 0.2) 0%, transparent 25%),
          radial-gradient(ellipse at 70% 35%, rgba(34, 238, 153, 0.4) 0%, transparent 28%),
          radial-gradient(ellipse at 35% 70%, rgba(168, 85, 247, 0.6) 0%, transparent 32%),
          radial-gradient(circle at 30% 25%, var(--purple-bright) 0%, var(--purple) 40%, var(--purple-deep) 75%, var(--void) 100%);
        box-shadow:
          inset -30px -30px 80px rgba(0, 0, 0, 0.6),
          inset 20px 20px 60px rgba(255, 255, 255, 0.08),
          0 30px 80px rgba(168, 85, 247, 0.5),
          0 0 0 1px rgba(212, 216, 227, 0.15);
        border: none;
        padding: 0;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
        overflow: hidden;
      }
      .planet-hero:hover {
        transform: scale(1.02);
        box-shadow:
          inset -30px -30px 80px rgba(0, 0, 0, 0.6),
          inset 20px 20px 60px rgba(255, 255, 255, 0.12),
          0 30px 90px rgba(168, 85, 247, 0.7),
          0 0 0 1px var(--green);
      }
      .planet-hero:active {
        transform: scale(0.98);
      }
      .planet-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.18;
        mix-blend-mode: overlay;
        pointer-events: none;
      }
      .planet-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.45) 0%, transparent 28%);
        pointer-events: none;
      }

      .surface {
        position: absolute;
        inset: 8%;
        border-radius: 50%;
        overflow: hidden;
        pointer-events: none;
        z-index: 2;
        animation: planetSpin 100s linear infinite;
      }
      @keyframes planetSpin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
      .surface svg {
        width: 100%;
        height: 100%;
        display: block;
      }

      .planet-scan {
        position: absolute;
        inset: 8%;
        border-radius: 50%;
        overflow: hidden;
        pointer-events: none;
        z-index: 3;
      }
      .planet-scan::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--green), transparent);
        box-shadow:
          0 0 20px var(--green),
          0 0 40px var(--green);
        opacity: 0.7;
        animation: scanSweep 4s ease-in-out infinite;
      }
      @keyframes scanSweep {
        0% {
          top: 0%;
          opacity: 0;
        }
        10% {
          opacity: 0.7;
        }
        90% {
          opacity: 0.7;
        }
        100% {
          top: 100%;
          opacity: 0;
        }
      }

      .planet-stage::before,
      .planet-stage::after {
        content: "";
        position: absolute;
        width: 28px;
        height: 28px;
        border: 1px solid var(--green);
        opacity: 0.5;
        pointer-events: none;
      }
      .planet-stage::before {
        top: 0;
        left: 0;
        border-right: 0;
        border-bottom: 0;
      }
      .planet-stage::after {
        bottom: 0;
        right: 0;
        border-left: 0;
        border-top: 0;
      }

      .orbit-ring {
        position: absolute;
        inset: -10%;
        pointer-events: none;
        z-index: 4;
      }
      .orbit-1 {
        animation: orbSpinOrbit 22s linear infinite;
      }
      .orbit-2 {
        animation: orbSpinOrbit 32s linear infinite reverse;
        inset: -16%;
      }
      .orbit-3 {
        animation: orbSpinOrbit 14s linear infinite;
        inset: -22%;
      }
      @keyframes orbSpinOrbit {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      .moonlet {
        position: absolute;
        top: -2%;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, var(--green-bright), var(--green) 50%, var(--green-deep) 100%);
        box-shadow:
          0 0 16px var(--green-glow),
          inset -4px -4px 8px rgba(0, 0, 0, 0.4);
      }
      .orbit-1 .moonlet {
        width: 28px;
        height: 28px;
      }
      .orbit-2 .moonlet {
        width: 18px;
        height: 18px;
        background: radial-gradient(circle at 35% 30%, var(--purple-bright), var(--purple) 50%, var(--purple-deep) 100%);
        box-shadow:
          0 0 16px var(--purple-glow),
          inset -3px -3px 6px rgba(0, 0, 0, 0.4);
      }
      .orbit-3 .moonlet {
        width: 12px;
        height: 12px;
        background: var(--chrome);
        box-shadow:
          0 0 12px var(--chrome),
          inset -2px -2px 4px rgba(0, 0, 0, 0.3);
      }

      .planet-sparkles {
        position: absolute;
        inset: -20%;
        pointer-events: none;
        z-index: 4;
      }
      .planet-sparkles .sparkle {
        position: absolute;
        color: var(--green);
        will-change: opacity;
        animation: twinkle var(--dur, 2.4s) ease-in-out infinite;
        animation-delay: var(--delay, 0s);
      }
      .planet-sparkles .sparkle.purple {
        color: var(--purple);
      }
      .planet-sparkles .sparkle.chrome {
        color: var(--chrome);
      }
      .planet-sparkles .sparkle svg {
        width: 100%;
        height: 100%;
        fill: currentColor;
        filter: drop-shadow(0 0 4px currentColor);
      }

      .ripple {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        border: 2px solid var(--green);
        animation: rippleOut 1s ease-out forwards;
      }
      @keyframes rippleOut {
        0% {
          width: 0;
          height: 0;
          opacity: 0.9;
          box-shadow: 0 0 20px var(--green);
        }
        100% {
          width: 200px;
          height: 200px;
          opacity: 0;
        }
      }

      .pop {
        position: absolute;
        pointer-events: none;
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        font-size: 18px;
        color: var(--green);
        text-shadow: 0 0 8px var(--green-glow);
        animation: popUp 1.2s ease-out forwards;
      }
      @keyframes popUp {
        0% {
          transform: translate(-50%, -50%) translateY(0) scale(0.8);
          opacity: 0;
        }
        20% {
          transform: translate(-50%, -50%) translateY(-10px) scale(1.1);
          opacity: 1;
        }
        100% {
          transform: translate(-50%, -50%) translateY(-60px) scale(1);
          opacity: 0;
        }
      }

      .ground {
        position: fixed;
        bottom: 18px;
        left: 0;
        right: 0;
        z-index: 6;
        text-align: center;
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--steel);
        pointer-events: none;
      }
      .ground a {
        color: var(--green);
        text-decoration: none;
        pointer-events: auto;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }
      .ground a:hover {
        border-bottom-color: var(--green);
      }

      /* entrance */
      .hero-left > *,
      .planet-stage {
        opacity: 0;
        transform: translateY(8px);
        transition:
          opacity 0.7s ease-out,
          transform 0.7s ease-out;
      }
      .fonts-ready .hero-left > *,
      .fonts-late .hero-left > *,
      .fonts-ready .planet-stage,
      .fonts-late .planet-stage {
        opacity: 1;
        transform: translateY(0);
      }
      .fonts-ready .hero-left > *:nth-child(1) {
        transition-delay: 0s;
      }
      .fonts-ready .hero-left > *:nth-child(2) {
        transition-delay: 0.08s;
      }
      .fonts-ready .hero-left > *:nth-child(3) {
        transition-delay: 0.16s;
      }
      .fonts-ready .hero-left > *:nth-child(4) {
        transition-delay: 0.24s;
      }
      .fonts-ready .hero-left > *:nth-child(5) {
        transition-delay: 0.32s;
      }
      .fonts-ready .hero-left > *:nth-child(6) {
        transition-delay: 0.4s;
      }
      .fonts-ready .planet-stage {
        transition-delay: 0.2s;
      }
      .ground {
        opacity: 0;
        transition: opacity 0.6s ease-out 0.6s;
      }
      .fonts-ready .ground,
      .fonts-late .ground {
        opacity: 1;
      }

      /* prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        .twinkle,
        .sparkle,
        .planet-aura,
        .surface,
        .orbit-ring,
        .planet-scan::before,
        .signal-counter::before,
        .hero-tag .ht-dot,
        .coming-soon .cs-dot,
        .wordmark .wm-orb,
        .hero-left > *,
        .planet-stage,
        .ground {
          animation: none !important;
          transition: none !important;
        }
        .hero-left > *,
        .planet-stage,
        .ground {
          opacity: 1 !important;
          transform: none !important;
        }
      }

      /* responsive */
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
          grid-template-rows: 1fr auto;
          padding: 50px 24px 70px;
          gap: 20px;
        }
        .hero-left {
          align-items: center;
          text-align: center;
        }
        .hero-right {
          height: auto;
          max-height: 50vh;
        }
        .planet-stage {
          width: clamp(240px, 60vw, 380px);
        }
        .hero-wordmark {
          font-size: clamp(64px, 14vw, 110px);
        }
      }
      @media (max-width: 600px) {
        .hero {
          padding: 40px 18px 60px;
        }
        .coming-soon {
          padding: 9px 16px;
          font-size: 10px;
          letter-spacing: 0.22em;
        }
        .ground {
          font-size: 8px;
          padding: 0 18px;
        }
      }
      @media (max-height: 700px) and (min-width: 901px) {
        .hero-wordmark {
          font-size: clamp(60px, 8vw, 110px);
          margin-bottom: 16px;
        }
        .slogan-en {
          margin-bottom: 8px;
        }
        .slogan-zh {
          margin-bottom: 22px;
        }
        .signal-counter {
          margin-bottom: 18px;
          padding: 8px 14px;
        }
        .signal-counter .sc-value {
          font-size: 16px;
        }
        .planet-stage {
          width: clamp(280px, 40vw, 460px);
        }
      }
    </style>
  </body>
</html>
