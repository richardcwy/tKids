---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>tRadio — 太空漫遊的共頻</title>
    <meta
      name="description"
      content="tRadio — 太空漫遊的共頻。t 宇宙電台，由社群點播。Coming Spring 2027."
    />
    <meta property="og:title" content="tRadio — 太空漫遊的共頻" />
    <meta
      property="og:description"
      content="tRadio — 太空漫遊的共頻。t 宇宙電台，由社群點播。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tkids.tw/tradio" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://tkids.tw/tradio" />
  </head>
  <body>
    <div class="bg-atmosphere">
      <div class="aurora a1" aria-hidden="true"></div>
      <div class="aurora a2" aria-hidden="true"></div>
      <div class="aurora a3" aria-hidden="true"></div>
      <div class="aurora a4" aria-hidden="true"></div>
      <div class="aurora a5" aria-hidden="true"></div>
    </div>
    <div class="star-field" id="starField" aria-hidden="true"></div>

    <div class="stage">
      <div class="hero-left">
        <div class="wordmark-card">
          <div class="card-aurora" aria-hidden="true">
            <div class="card-curtain cc1"></div>
            <div class="card-curtain cc2"></div>
            <div class="card-curtain cc3"></div>
          </div>
          <div class="hero-tag">
            <span class="ht-dot" aria-hidden="true"></span>
            訊號 · t 宇宙
          </div>
          <h1 class="wordmark hero-wordmark">
            <span>t</span>
            <span class="wm-orbit" aria-hidden="true">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <ellipse
                  class="ring"
                  cx="12"
                  cy="12"
                  rx="10"
                  ry="3.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  transform="rotate(-22 12 12)"
                ></ellipse>
                <circle class="core" cx="12" cy="12" r="3.4" fill="currentColor"
                ></circle>
              </svg>
            </span>
            <span>Radio</span>
          </h1>
          <p class="slogan-zh-headline">太空漫遊的<em>共頻</em></p>
          <p class="slogan-zh-desc">
            每個人都可以點歌，<span class="brand">t 宇宙電台</span>的<span
              class="accent">共鳴</span>
          </p>
        </div>

        <div class="signin-prompt">
          <div class="signin-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d={spotifyIconPath}></path>
            </svg>
          </div>
          <div class="signin-body">
            <div class="signin-title">使用 Spotify 帳號登入後即可點歌</div>
            <div class="signin-desc">
              tRadio 串接 Spotify 播放服務，需要 <b>Spotify Premium</b>
              帳號才能完整收聽歌單。免費帳號也可登入點歌、留言，但歌曲將以 30
              秒試聽方式播放。
            </div>
            <button class="signin-btn" id="spotifySignInBtn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={spotifyIconPath}></path>
              </svg>
              使用 Spotify 帳號登入
            </button>
          </div>
        </div>

        <div class="hero-meta">
          <div class="coming-soon">
            <span class="cs-dot" aria-hidden="true"></span>
            即將上線 · <b>2027 春</b>
          </div>
          <div class="universe-link">
            屬於 <a href="https://tkids.tw" rel="noopener">tKids</a> 宇宙
          </div>
        </div>
      </div>

      <div class="player-stack">
        <div class="spotify-embed-frame">
          <div class="embed-header">
            <div class="embed-title">
              <span class="live-marker">preview</span>
              tRadio Channel 07 · 共頻歌單
            </div>
            <div class="embed-meta">上線時顯示<b>即時</b>聽眾數</div>
          </div>
          <div class="embed-iframe-wrap">
            <iframe
              class="spotify-iframe"
              src="https://open.spotify.com/embed/playlist/2UxU4vMWf9VlUuFvhbbPs8?utm_source=generator&theme=0"
              width="100%"
              height="352"
              frameborder="0"
              allowfullscreen=""
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
              title="tRadio · 共頻歌單 — Spotify"
            ></iframe>
          </div>
          <div class="embed-attribution">
            歌單由
            <a
              href="https://open.spotify.com/playlist/2UxU4vMWf9VlUuFvhbbPs8"
              target="_blank"
              rel="noopener">Spotify</a> 提供 ·
            <a href="https://www.spotify.com" target="_blank" rel="noopener">
              Spotify
            </a> is a trademark of Spotify AB · tRadio 為獨立第三方網站，與 Spotify
            無關
          </div>
        </div>

        <div class="noms-frame">
          <div class="noms-header">
            <div>
              <div class="noms-label">候選歌曲 · 待 Richard 挑選</div>
              <div class="noms-sublabel">
                為你支持的歌曲投票，越多人投票越有機會被加入歌單
              </div>
            </div>
            <div class="noms-count">
              候選中 <b id="nomCount">{noms.length}</b> 首
            </div>
          </div>

          <div class="noms-grid" id="nomsGrid">
            {noms.map((n) => (
              <div class="nom-card">
                <div class="nom-cover" style={`background: ${n.cover};`}>
                  <span class="nom-cover-mark">♪</span>
                </div>
                <div class="nom-body">
                  <div class="nom-titles">
                    <div class="nom-title">{n.title}</div>
                    <div class="nom-artist">{n.artist}</div>
                  </div>
                  <div class="nom-comment">{n.comment}</div>
                  <div class="nom-foot">
                    <div class="nom-by">
                      <span class="mini-avatar" style={`background: ${n.avatar};`}>
                        {n.by[0]}
                      </span>
                      <span class="mini-name">{n.by}</span>
                    </div>
                    <button
                      class:list={["nom-vote", { "is-voted": n.voted }]}
                      data-votes={n.votes}
                    >
                      <svg viewBox="0 0 24 24"
                        ><path d="M12 4l8 8h-5v8h-6v-8H4z"></path></svg>
                      <span class="vote-count">{n.votes}</span>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="active-users">
            <div class="au-label">
              <span class="au-pulse" aria-hidden="true"></span>
              現在線上 · <b>23</b> 人
            </div>
            <div class="au-avatars">
              {activeAvatars.map((a) => (
                <span class="au-avatar" style={`background: ${a.grad};`}>
                  {a.initial}
                </span>
              ))}
              <span class="au-avatar au-more">+15</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Background twinkling stars
      const starField = document.getElementById("starField");
      function buildStarField() {
        starField.innerHTML = "";
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const count = Math.max(30, Math.min(60, Math.round((vw * vh) / 28000)));
        for (let i = 0; i < count; i++) {
          const s = document.createElement("div");
          s.className = "twinkle";
          const r = Math.random();
          if (r < 0.18) s.classList.add("beacon");
          else if (r < 0.3) s.classList.add("gold");
          const size = 4 + Math.random() * 8;
          s.style.width = size + "px";
          s.style.height = size + "px";
          s.style.left = Math.random() * vw + "px";
          s.style.top = Math.random() * vh + "px";
          s.style.setProperty("--dur", 2.5 + Math.random() * 3 + "s");
          s.style.setProperty("--delay", Math.random() * 3 + "s");
          if (Math.random() < 0.5) {
            s.innerHTML =
              '<svg viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>';
          } else {
            s.innerHTML =
              '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/></svg>';
          }
          starField.appendChild(s);
        }
      }
      buildStarField();
      let resizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(buildStarField, 200);
      });

      // Aurora bursts — irregular brightness pulses on individual curtains
      // so the aurora reads "alive" instead of mechanical.
      const auroraCurtains = document.querySelectorAll(
        ".aurora, .card-curtain",
      );
      let burstTimer = null;
      function triggerAuroraBurst() {
        if (document.visibilityState !== "visible") return;
        const burstCount = Math.random() < 0.3 ? 2 : 1;
        const shuffled = [...auroraCurtains].sort(() => Math.random() - 0.5);
        const targets = shuffled.slice(0, burstCount);
        targets.forEach((curtain) => {
          const burstStrength = 1.4 + Math.random() * 0.5;
          const burstSat = 1.2 + Math.random() * 0.3;
          curtain.style.transition =
            "filter 0.6s cubic-bezier(0.2, 0.8, 0.4, 1)";
          curtain.style.filter = `${getComputedStyle(curtain).filter} brightness(${burstStrength}) saturate(${burstSat})`;
          setTimeout(
            () => {
              curtain.style.transition = "filter 1.8s ease-out";
              curtain.style.filter = "";
            },
            400 + Math.random() * 600,
          );
        });
      }
      function scheduleNextBurst() {
        if (document.visibilityState !== "visible") return;
        const delay = 4000 + Math.random() * 8000;
        burstTimer = setTimeout(() => {
          triggerAuroraBurst();
          scheduleNextBurst();
        }, delay);
      }
      function stopBursts() {
        if (burstTimer) {
          clearTimeout(burstTimer);
          burstTimer = null;
        }
      }
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          if (burstTimer === null) scheduleNextBurst();
        } else {
          stopBursts();
        }
      });
      setTimeout(scheduleNextBurst, 3000);

      // Sign-in placeholder — will hit Spotify OAuth in production.
      const spotifySignInBtn = document.getElementById("spotifySignInBtn");
      if (spotifySignInBtn) {
        spotifySignInBtn.addEventListener("click", () => {
          console.log(
            "[tRadio] Sign-in clicked — production would redirect to Spotify OAuth",
          );
        });
      }

      // Upvote behavior
      document.querySelectorAll(".nom-vote").forEach((btn) => {
        btn.addEventListener("click", () => {
          const isVoted = btn.classList.toggle("is-voted");
          const countEl = btn.querySelector(".vote-count");
          let n = parseInt(countEl.textContent, 10);
          n = isVoted ? n + 1 : n - 1;
          countEl.textContent = n;
        });
      });
    </script>

    <style is:global>
      :root {
        --void: #04060c;
        --charcoal: #0a0d14;
        --indigo: #131826;
        --steel-deep: #1c2335;
        --beacon: #22e88a;
        --beacon-bright: #6dffb1;
        --beacon-deep: #0fa55f;
        --plasma: #5fdec9;
        --plasma-bright: #8eede0;
        --plasma-deep: #2da896;
        --gold: #ffd84a;
        --gold-deep: #e8b840;
        --gold-warm: #ffc870;
        --ion: #ff6dba;
        --hydrogen: #e8f0ff;
        --hydrogen-dim: #b8c4dc;
        --lunar: #7d8aa3;
        --slate: #4a5269;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      /* Page-scoped satellite cursor */
      html, body {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><g fill='none' stroke='%235fdec9' stroke-width='1.2' opacity='0.85'><ellipse cx='16' cy='16' rx='13' ry='5' transform='rotate(-22 16 16)'/></g><circle cx='16' cy='16' r='3' fill='%2322e88a'/></svg>") 16 16, auto;
      }
      a, button, [role='button'], input, textarea {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><g fill='none' stroke='%235fdec9' stroke-width='1.4'><ellipse cx='20' cy='20' rx='17' ry='6.5' transform='rotate(-22 20 20)'/></g><circle cx='20' cy='20' r='4' fill='%2322e88a'/></svg>") 20 20, pointer;
      }
      input, textarea { cursor: text; }

      body {
        background: var(--void);
        color: var(--hydrogen);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .bg-atmosphere {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 1400px 1000px at 50% 100%, rgba(34, 232, 138, 0.05) 0%, transparent 60%),
          linear-gradient(180deg, var(--void) 0%, var(--charcoal) 70%, #02030a 100%);
        overflow: hidden;
      }
      .bg-atmosphere::before {
        content: "";
        position: absolute; inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.06;
        mix-blend-mode: overlay;
        z-index: 3;
      }
      .bg-atmosphere::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0; right: 0;
        height: 40%;
        background: linear-gradient(180deg, transparent, rgba(4, 6, 12, 0.7));
        pointer-events: none;
        z-index: 2;
      }

      /* Aurora curtains */
      .aurora {
        position: absolute;
        top: -8%;
        height: 120%;
        border-radius: 50%;
        pointer-events: none;
        mix-blend-mode: screen;
        will-change: transform, opacity, filter;
        transform-origin: 50% 0%;
      }
      .aurora.a1 {
        width: 45%;
        left: -5%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(255, 109, 186, 0.18) 12%,
          rgba(168, 85, 247, 0.32) 28%,
          rgba(95, 222, 201, 0.4) 50%,
          rgba(34, 232, 138, 0.55) 72%,
          rgba(34, 232, 138, 0.3) 92%,
          transparent 100%);
        filter: blur(50px);
        animation: auroraDrift1 28s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
      }
      @keyframes auroraDrift1 {
        0%   { transform: translateX(0) skewX(-6deg) scaleY(1) scaleX(1); opacity: 0.7; }
        18%  { transform: translateX(15%) skewX(4deg) scaleY(1.12) scaleX(0.92); opacity: 1; }
        35%  { transform: translateX(28%) skewX(-2deg) scaleY(0.88) scaleX(1.08); opacity: 0.85; }
        52%  { transform: translateX(38%) skewX(8deg) scaleY(1.18) scaleX(0.95); opacity: 0.95; }
        70%  { transform: translateX(22%) skewX(-4deg) scaleY(0.92) scaleX(1.05); opacity: 0.6; }
        85%  { transform: translateX(8%) skewX(2deg) scaleY(1.08) scaleX(0.98); opacity: 0.8; }
        100% { transform: translateX(0) skewX(-6deg) scaleY(1) scaleX(1); opacity: 0.7; }
      }
      .aurora.a2 {
        width: 32%;
        left: 30%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(255, 109, 186, 0.45) 10%,
          rgba(168, 85, 247, 0.4) 30%,
          rgba(95, 222, 201, 0.28) 55%,
          rgba(34, 232, 138, 0.35) 78%,
          rgba(34, 232, 138, 0.15) 95%,
          transparent 100%);
        filter: blur(45px);
        animation: auroraDrift2 36s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        animation-delay: -8s;
      }
      @keyframes auroraDrift2 {
        0%   { transform: translateX(0) skewX(8deg) scaleY(1) scaleX(1); opacity: 0.65; }
        22%  { transform: translateX(-18%) skewX(-3deg) scaleY(1.15) scaleX(0.88); opacity: 0.9; }
        40%  { transform: translateX(-8%) skewX(12deg) scaleY(0.85) scaleX(1.12); opacity: 1; }
        58%  { transform: translateX(15%) skewX(-6deg) scaleY(1.2) scaleX(0.9); opacity: 0.55; }
        78%  { transform: translateX(5%) skewX(4deg) scaleY(0.95) scaleX(1.06); opacity: 0.8; }
