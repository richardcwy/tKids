---
// Standalone teaser landing for tRadio, the fifth pillar of the t-universe.
// Lives at /tradio. Same standalone pattern as /tgirls, /tplanet, /tbeast —
// bypasses Layout.astro, page-scoped palette + cursor via is:global.
//
// v2 layout (from tRadio Concept/tradio-landing_v2.html):
//   - Spotify embed used bare per Spotify Widget Terms — no faux chrome
//     wrapping the iframe.
//   - Nominations grid renders an honest empty-state with arrow pointing
//     at the sign-in CTA. No mock user data, no fake listener counts.
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/inter/900.css";
import "@fontsource/fraunces/400-italic.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/600-italic.css";
import "@fontsource/jetbrains-mono/300.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/noto-sans-tc/300.css";
import "@fontsource/noto-sans-tc/400.css";
import "@fontsource/noto-sans-tc/500.css";
import "@fontsource/noto-sans-tc/700.css";
import "@fontsource/noto-serif-tc/400.css";
import "@fontsource/noto-serif-tc/500.css";
import "@fontsource/noto-serif-tc/600.css";
import "@fontsource/noto-serif-tc/700.css";

const ogImage = "/og-default.png";

const spotifyIconPath =
  "M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.84-.179-.94-.6-.12-.421.18-.84.6-.94 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.282 1.121zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.42 1.56-.299.421-1.02.599-1.559.3z";
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>tRadio — 太空漫遊的共頻</title>
    <meta
      name="description"
      content="tRadio — 太空漫遊的共頻。t 宇宙電台，由社群點播。Coming Spring 2027."
    />
    <meta property="og:title" content="tRadio — 太空漫遊的共頻" />
    <meta
      property="og:description"
      content="tRadio — 太空漫遊的共頻。t 宇宙電台，由社群點播。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tkids.tw/tradio" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://tkids.tw/tradio" />
    <GoogleAnalytics />
  </head>
  <body>
    <div class="bg-atmosphere">
      <div class="aurora a1" aria-hidden="true"></div>
      <div class="aurora a2" aria-hidden="true"></div>
      <div class="aurora a3" aria-hidden="true"></div>
      <div class="aurora a4" aria-hidden="true"></div>
      <div class="aurora a5" aria-hidden="true"></div>
    </div>
    <div class="star-field" id="starField" aria-hidden="true"></div>

    <div class="stage">
      <div class="hero-left">
        <div class="wordmark-card">
          <div class="card-aurora" aria-hidden="true">
            <div class="card-curtain cc1"></div>
            <div class="card-curtain cc2"></div>
            <div class="card-curtain cc3"></div>
          </div>
          <div class="hero-tag">
            <span class="ht-dot" aria-hidden="true"></span>
            訊號 · t 宇宙
          </div>
          <h1 class="wordmark hero-wordmark">
            <span>t</span>
            <span class="wm-orbit" aria-hidden="true">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <ellipse
                  class="ring"
                  cx="12"
                  cy="12"
                  rx="10"
                  ry="3.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  transform="rotate(-22 12 12)"
                ></ellipse>
                <circle class="core" cx="12" cy="12" r="3.4" fill="currentColor"
                ></circle>
              </svg>
            </span>
            <span>Radio</span>
          </h1>
          <p class="slogan-zh-headline">太空漫遊的<em>共頻</em></p>
          <p class="slogan-zh-desc">
            每個人都可以點歌，<span class="brand">t 宇宙電台</span>的<span
              class="accent">共鳴</span>
          </p>
        </div>

        <div class="signin-prompt">
          <div class="signin-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d={spotifyIconPath}></path>
            </svg>
          </div>
          <div class="signin-body">
            <div class="signin-title">使用 Spotify 帳號登入後即可點歌</div>
            <div class="signin-desc">
              tRadio 串接 Spotify 播放服務，需要 <b>Spotify Premium</b>
              帳號才能完整收聽歌單。免費帳號也可登入點歌、留言，但歌曲將以 30
              秒試聽方式播放。
            </div>
            <button class="signin-btn" id="spotifySignInBtn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={spotifyIconPath}></path>
              </svg>
              使用 Spotify 帳號登入
            </button>
          </div>
        </div>

        <div class="hero-meta">
          <div class="coming-soon">
            <span class="cs-dot" aria-hidden="true"></span>
            即將上線 · <b>2027 春</b>
          </div>
          <div class="universe-link">
            屬於 <a href="https://tkids.tw" rel="noopener">tKids</a> 宇宙
          </div>
        </div>
      </div>

      <div class="player-stack">
        <iframe
          class="spotify-embed"
          style="border-radius: 12px"
          src="https://open.spotify.com/embed/playlist/2UxU4vMWf9VlUuFvhbbPs8?utm_source=generator"
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="tRadio · 共頻歌單 — Spotify"
        ></iframe>

        <div class="noms-frame">
          <div class="noms-header">
            <div>
              <div class="noms-label">候選歌曲 · 待 tAdmin 挑選</div>
              <div class="noms-sublabel">
                登入後即可點歌、留言，並為你喜歡的歌曲投票
              </div>
            </div>
            <div class="noms-count">候選中 <b id="nomCount">0</b> 首</div>
          </div>

          <div class="noms-empty">
            <div class="noms-empty-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <ellipse
                  cx="12"
                  cy="12"
                  rx="10"
                  ry="3.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  transform="rotate(-22 12 12)"></ellipse>
                <circle cx="12" cy="12" r="3.4" fill="currentColor"></circle>
              </svg>
            </div>
            <div class="noms-empty-title">等待第一個訊號</div>
            <div class="noms-empty-desc">
              歌單還是一片寧靜的星空。<br />
              登入後就能點下你的第一首歌，<br />
              你的點播也會顯示在這裡，<br />
              讓其他人為它投票支持。
            </div>
            <div class="noms-empty-hint">
              <span class="emp-arrow" aria-hidden="true">←</span>
              使用左側的 Spotify 帳號登入開始
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Background twinkling stars
      const starField = document.getElementById("starField");
      function buildStarField() {
        starField.innerHTML = "";
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const count = Math.max(30, Math.min(60, Math.round((vw * vh) / 28000)));
        for (let i = 0; i < count; i++) {
          const s = document.createElement("div");
          s.className = "twinkle";
          const r = Math.random();
          if (r < 0.18) s.classList.add("beacon");
          else if (r < 0.3) s.classList.add("gold");
          const size = 4 + Math.random() * 8;
          s.style.width = size + "px";
          s.style.height = size + "px";
          s.style.left = Math.random() * vw + "px";
          s.style.top = Math.random() * vh + "px";
          s.style.setProperty("--dur", 2.5 + Math.random() * 3 + "s");
          s.style.setProperty("--delay", Math.random() * 3 + "s");
          if (Math.random() < 0.5) {
            s.innerHTML =
              '<svg viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>';
          } else {
            s.innerHTML =
              '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/></svg>';
          }
          starField.appendChild(s);
        }
      }
      buildStarField();
      let resizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(buildStarField, 200);
      });

      // Aurora bursts — irregular brightness pulses on individual curtains
      // so the aurora reads "alive" instead of mechanical.
      const auroraCurtains = document.querySelectorAll(
        ".aurora, .card-curtain",
      );
      let burstTimer = null;
      function triggerAuroraBurst() {
        if (document.visibilityState !== "visible") return;
        const burstCount = Math.random() < 0.3 ? 2 : 1;
        const shuffled = [...auroraCurtains].sort(() => Math.random() - 0.5);
        const targets = shuffled.slice(0, burstCount);
        targets.forEach((curtain) => {
          const burstStrength = 1.4 + Math.random() * 0.5;
          const burstSat = 1.2 + Math.random() * 0.3;
          curtain.style.transition =
            "filter 0.6s cubic-bezier(0.2, 0.8, 0.4, 1)";
          curtain.style.filter = `${getComputedStyle(curtain).filter} brightness(${burstStrength}) saturate(${burstSat})`;
          setTimeout(
            () => {
              curtain.style.transition = "filter 1.8s ease-out";
              curtain.style.filter = "";
            },
            400 + Math.random() * 600,
          );
        });
      }
      function scheduleNextBurst() {
        if (document.visibilityState !== "visible") return;
        const delay = 4000 + Math.random() * 8000;
        burstTimer = setTimeout(() => {
          triggerAuroraBurst();
          scheduleNextBurst();
        }, delay);
      }
      function stopBursts() {
        if (burstTimer) {
          clearTimeout(burstTimer);
          burstTimer = null;
        }
      }
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          if (burstTimer === null) scheduleNextBurst();
        } else {
          stopBursts();
        }
      });
      setTimeout(scheduleNextBurst, 3000);

      // Sign-in placeholder — will hit Spotify OAuth in production.
      const spotifySignInBtn = document.getElementById("spotifySignInBtn");
      if (spotifySignInBtn) {
        spotifySignInBtn.addEventListener("click", () => {
          console.log(
            "[tRadio] Sign-in clicked — production would redirect to Spotify OAuth",
          );
        });
      }
    </script>

    <style is:global>
      :root {
        --void: #04060c;
        --charcoal: #0a0d14;
        --indigo: #131826;
        --steel-deep: #1c2335;
        --beacon: #22e88a;
        --beacon-bright: #6dffb1;
        --beacon-deep: #0fa55f;
        --plasma: #5fdec9;
        --plasma-bright: #8eede0;
        --plasma-deep: #2da896;
        --gold: #ffd84a;
        --gold-deep: #e8b840;
        --gold-warm: #ffc870;
        --ion: #ff6dba;
        --hydrogen: #e8f0ff;
        --hydrogen-dim: #b8c4dc;
        --lunar: #7d8aa3;
        --slate: #4a5269;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      /* Page-scoped satellite cursor */
      html, body {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><g fill='none' stroke='%235fdec9' stroke-width='1.2' opacity='0.85'><ellipse cx='16' cy='16' rx='13' ry='5' transform='rotate(-22 16 16)'/></g><circle cx='16' cy='16' r='3' fill='%2322e88a'/></svg>") 16 16, auto;
      }
      a, button, [role='button'], input, textarea {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><g fill='none' stroke='%235fdec9' stroke-width='1.4'><ellipse cx='20' cy='20' rx='17' ry='6.5' transform='rotate(-22 20 20)'/></g><circle cx='20' cy='20' r='4' fill='%2322e88a'/></svg>") 20 20, pointer;
      }
      input, textarea { cursor: text; }

      body {
        background: var(--void);
        color: var(--hydrogen);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .bg-atmosphere {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 1400px 1000px at 50% 100%, rgba(34, 232, 138, 0.05) 0%, transparent 60%),
          linear-gradient(180deg, var(--void) 0%, var(--charcoal) 70%, #02030a 100%);
        overflow: hidden;
      }
      .bg-atmosphere::before {
        content: "";
        position: absolute; inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.06;
        mix-blend-mode: overlay;
        z-index: 3;
      }
      .bg-atmosphere::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0; right: 0;
        height: 40%;
        background: linear-gradient(180deg, transparent, rgba(4, 6, 12, 0.7));
        pointer-events: none;
        z-index: 2;
      }

      /* Aurora curtains */
      .aurora {
        position: absolute;
        top: -8%;
        height: 120%;
        border-radius: 50%;
        pointer-events: none;
        mix-blend-mode: screen;
        will-change: transform, opacity, filter;
        transform-origin: 50% 0%;
      }
      .aurora.a1 {
        width: 45%;
        left: -5%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(255, 109, 186, 0.18) 12%,
          rgba(168, 85, 247, 0.32) 28%,
          rgba(95, 222, 201, 0.4) 50%,
          rgba(34, 232, 138, 0.55) 72%,
          rgba(34, 232, 138, 0.3) 92%,
          transparent 100%);
        filter: blur(50px);
        animation: auroraDrift1 28s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
      }
      @keyframes auroraDrift1 {
        0%   { transform: translateX(0) skewX(-6deg) scaleY(1) scaleX(1); opacity: 0.7; }
        18%  { transform: translateX(15%) skewX(4deg) scaleY(1.12) scaleX(0.92); opacity: 1; }
        35%  { transform: translateX(28%) skewX(-2deg) scaleY(0.88) scaleX(1.08); opacity: 0.85; }
        52%  { transform: translateX(38%) skewX(8deg) scaleY(1.18) scaleX(0.95); opacity: 0.95; }
        70%  { transform: translateX(22%) skewX(-4deg) scaleY(0.92) scaleX(1.05); opacity: 0.6; }
        85%  { transform: translateX(8%) skewX(2deg) scaleY(1.08) scaleX(0.98); opacity: 0.8; }
        100% { transform: translateX(0) skewX(-6deg) scaleY(1) scaleX(1); opacity: 0.7; }
      }
      .aurora.a2 {
        width: 32%;
        left: 30%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(255, 109, 186, 0.45) 10%,
          rgba(168, 85, 247, 0.4) 30%,
          rgba(95, 222, 201, 0.28) 55%,
          rgba(34, 232, 138, 0.35) 78%,
          rgba(34, 232, 138, 0.15) 95%,
          transparent 100%);
        filter: blur(45px);
        animation: auroraDrift2 36s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        animation-delay: -8s;
      }
      @keyframes auroraDrift2 {
        0%   { transform: translateX(0) skewX(8deg) scaleY(1) scaleX(1); opacity: 0.65; }
        22%  { transform: translateX(-18%) skewX(-3deg) scaleY(1.15) scaleX(0.88); opacity: 0.9; }
        40%  { transform: translateX(-8%) skewX(12deg) scaleY(0.85) scaleX(1.12); opacity: 1; }
        58%  { transform: translateX(15%) skewX(-6deg) scaleY(1.2) scaleX(0.9); opacity: 0.55; }
        78%  { transform: translateX(5%) skewX(4deg) scaleY(0.95) scaleX(1.06); opacity: 0.8; }
        100% { transform: translateX(0) skewX(8deg) scaleY(1) scaleX(1); opacity: 0.65; }
      }
      .aurora.a3 {
        width: 38%;
        left: 50%;
        background: linear-gradient(180deg,
          rgba(168, 85, 247, 0) 0%,
          rgba(168, 85, 247, 0.22) 14%,
          rgba(95, 222, 201, 0.45) 38%,
          rgba(109, 255, 177, 0.55) 62%,
          rgba(34, 232, 138, 0.4) 85%,
          transparent 100%);
        filter: blur(48px);
        animation: auroraDrift3 32s cubic-bezier(0.35, 0.05, 0.65, 0.95) infinite;
        animation-delay: -19s;
      }
      @keyframes auroraDrift3 {
        0%   { transform: translateX(0) skewX(-4deg) scaleY(1) scaleX(1); opacity: 0.75; }
        15%  { transform: translateX(-12%) skewX(6deg) scaleY(1.22) scaleX(0.85); opacity: 0.95; }
        32%  { transform: translateX(8%) skewX(-8deg) scaleY(0.82) scaleX(1.15); opacity: 1; }
        48%  { transform: translateX(20%) skewX(2deg) scaleY(1.1) scaleX(0.93); opacity: 0.6; }
        65%  { transform: translateX(5%) skewX(-10deg) scaleY(0.9) scaleX(1.08); opacity: 0.85; }
        82%  { transform: translateX(-8%) skewX(5deg) scaleY(1.05) scaleX(0.96); opacity: 0.7; }
        100% { transform: translateX(0) skewX(-4deg) scaleY(1) scaleX(1); opacity: 0.75; }
      }
      .aurora.a4 {
        width: 75%;
        left: 12%;
        height: 110%;
        top: -5%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(168, 85, 247, 0.15) 20%,
          rgba(95, 222, 201, 0.18) 50%,
          rgba(34, 232, 138, 0.22) 80%,
          transparent 100%);
        filter: blur(80px);
        animation: auroraDrift4 55s ease-in-out infinite;
        animation-delay: -32s;
      }
      @keyframes auroraDrift4 {
        0%, 100% { transform: translateX(0) skewX(-2deg) scaleY(1); opacity: 0.55; }
        33% { transform: translateX(8%) skewX(4deg) scaleY(1.08); opacity: 0.85; }
        66% { transform: translateX(-6%) skewX(-3deg) scaleY(0.96); opacity: 0.7; }
      }
      .aurora.a5 {
        width: 22%;
        left: 68%;
        height: 95%;
        top: 0%;
        background: linear-gradient(180deg,
          rgba(255, 216, 74, 0) 0%,
          rgba(255, 109, 186, 0.32) 18%,
          rgba(109, 255, 177, 0.45) 50%,
          rgba(34, 232, 138, 0.4) 80%,
          transparent 100%);
        filter: blur(40px);
        animation: auroraDrift5 22s cubic-bezier(0.3, 0, 0.7, 1) infinite;
        animation-delay: -5s;
      }
      @keyframes auroraDrift5 {
        0%   { transform: translateX(0) skewX(5deg) scaleY(1) scaleX(1); opacity: 0.55; }
        14%  { transform: translateX(-8%) skewX(-4deg) scaleY(1.25) scaleX(0.82); opacity: 0.95; }
        28%  { transform: translateX(6%) skewX(10deg) scaleY(0.78) scaleX(1.18); opacity: 1; }
        44%  { transform: translateX(-10%) skewX(-2deg) scaleY(1.15) scaleX(0.92); opacity: 0.5; }
        62%  { transform: translateX(8%) skewX(7deg) scaleY(0.9) scaleX(1.08); opacity: 0.8; }
        80%  { transform: translateX(-3%) skewX(-6deg) scaleY(1.1) scaleX(0.95); opacity: 0.65; }
        100% { transform: translateX(0) skewX(5deg) scaleY(1) scaleX(1); opacity: 0.55; }
      }

      .star-field { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
      .twinkle {
        position: absolute;
        color: var(--hydrogen);
        will-change: opacity;
        animation: twinkle var(--dur, 3s) ease-in-out infinite;
        animation-delay: var(--delay, 0s);
      }
      .twinkle.beacon { color: var(--beacon); }
      .twinkle.gold { color: var(--gold); }
      .twinkle svg { width: 100%; height: 100%; fill: currentColor; }
      @keyframes twinkle {
        0%, 100% { opacity: 0.15; transform: scale(0.8); }
        50% { opacity: 0.7; transform: scale(1.05); filter: drop-shadow(0 0 4px currentColor); }
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        font-family: "Inter", sans-serif;
        font-weight: 800;
        letter-spacing: -0.045em;
        line-height: 0.85;
        color: inherit;
        white-space: nowrap;
      }
      .wordmark > span { display: inline-block; }
      .wordmark .wm-orbit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 0.72em;
        height: 0.72em;
        margin: 0 0.04em;
        color: var(--beacon);
        flex-shrink: 0;
        transform: translateY(-0.04em);
      }
      .wordmark .wm-orbit svg { width: 100%; height: 100%; display: block; }
      .wordmark .wm-orbit .ring {
        transform-origin: center;
        transform-box: fill-box;
        animation: orbitSpin 9s linear infinite;
      }
      @keyframes orbitSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .wordmark .wm-orbit .core {
        transform-origin: center;
        transform-box: fill-box;
        animation: corePulse 1.8s ease-in-out infinite;
      }
      @keyframes corePulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(0.85); }
      }

      .stage {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100vh;
        display: grid;
        grid-template-columns: 4fr 8fr;
        gap: 28px;
        padding: 28px 28px 36px;
      }
      .hero-left {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 0;
      }

      .wordmark-card {
        position: relative;
        border-radius: 18px;
        padding: 32px 32px 26px;
        background: linear-gradient(135deg, var(--beacon-deep) 0%, var(--beacon) 50%, var(--ion) 100%);
        border: 1px solid var(--beacon-bright);
        box-shadow: 0 0 50px rgba(34, 232, 138, 0.25), 0 8px 24px rgba(0, 0, 0, 0.4);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .card-aurora {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
        border-radius: inherit;
      }
      .card-curtain {
        position: absolute;
        top: -10%;
        height: 130%;
        border-radius: 50%;
        pointer-events: none;
        mix-blend-mode: screen;
        will-change: transform, opacity, filter;
        transform-origin: 50% 0%;
      }
      .card-curtain.cc1 {
        width: 55%;
        left: -8%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(255, 109, 186, 0.35) 12%,
          rgba(168, 85, 247, 0.45) 32%,
          rgba(109, 255, 177, 0.55) 60%,
          rgba(34, 232, 138, 0.6) 85%,
          transparent 100%);
        filter: blur(28px);
        animation: cardAurora1 24s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
      }
      @keyframes cardAurora1 {
        0%   { transform: translateX(0) skewX(-5deg) scaleY(1) scaleX(1); opacity: 0.85; }
        20%  { transform: translateX(20%) skewX(6deg) scaleY(1.15) scaleX(0.9); opacity: 1; }
        40%  { transform: translateX(40%) skewX(-3deg) scaleY(0.85) scaleX(1.1); opacity: 0.75; }
        60%  { transform: translateX(55%) skewX(8deg) scaleY(1.2) scaleX(0.92); opacity: 0.95; }
        80%  { transform: translateX(20%) skewX(-2deg) scaleY(0.95) scaleX(1.04); opacity: 0.7; }
        100% { transform: translateX(0) skewX(-5deg) scaleY(1) scaleX(1); opacity: 0.85; }
      }
      .card-curtain.cc2 {
        width: 45%;
        left: 35%;
        background: linear-gradient(180deg,
          rgba(255, 109, 186, 0) 0%,
          rgba(255, 109, 186, 0.55) 14%,
          rgba(168, 85, 247, 0.4) 38%,
          rgba(109, 255, 177, 0.4) 70%,
          transparent 100%);
        filter: blur(25px);
        animation: cardAurora2 28s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        animation-delay: -7s;
      }
      @keyframes cardAurora2 {
        0%   { transform: translateX(0) skewX(7deg) scaleY(1) scaleX(1); opacity: 0.7; }
        25%  { transform: translateX(-15%) skewX(-4deg) scaleY(1.18) scaleX(0.85); opacity: 0.95; }
        45%  { transform: translateX(-5%) skewX(10deg) scaleY(0.82) scaleX(1.15); opacity: 1; }
        65%  { transform: translateX(20%) skewX(-6deg) scaleY(1.15) scaleX(0.93); opacity: 0.6; }
        85%  { transform: translateX(8%) skewX(4deg) scaleY(0.95) scaleX(1.06); opacity: 0.85; }
        100% { transform: translateX(0) skewX(7deg) scaleY(1) scaleX(1); opacity: 0.7; }
      }
      .card-curtain.cc3 {
        width: 35%;
        left: 60%;
        background: linear-gradient(180deg,
          rgba(168, 85, 247, 0) 0%,
          rgba(168, 85, 247, 0.3) 18%,
          rgba(95, 222, 201, 0.5) 45%,
          rgba(34, 232, 138, 0.55) 75%,
          transparent 100%);
        filter: blur(22px);
        animation: cardAurora3 18s cubic-bezier(0.3, 0.05, 0.65, 0.95) infinite;
        animation-delay: -12s;
      }
      @keyframes cardAurora3 {
        0%   { transform: translateX(0) skewX(-3deg) scaleY(1) scaleX(1); opacity: 0.65; }
        15%  { transform: translateX(-10%) skewX(8deg) scaleY(1.25) scaleX(0.82); opacity: 0.95; }
        32%  { transform: translateX(8%) skewX(-6deg) scaleY(0.78) scaleX(1.18); opacity: 1; }
        50%  { transform: translateX(-12%) skewX(4deg) scaleY(1.1) scaleX(0.92); opacity: 0.55; }
        70%  { transform: translateX(6%) skewX(-8deg) scaleY(0.92) scaleX(1.08); opacity: 0.8; }
        100% { transform: translateX(0) skewX(-3deg) scaleY(1) scaleX(1); opacity: 0.65; }
      }
      .wordmark-card::before {
        content: "";
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: 1;
      }
      .wordmark-card::after {
        content: "";
        position: absolute; inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.08;
        mix-blend-mode: overlay;
        pointer-events: none;
        z-index: 1;
      }
      .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: rgba(4, 6, 12, 0.45);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(232, 240, 255, 0.25);
        border-radius: 999px;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--hydrogen);
        margin-bottom: 24px;
        align-self: flex-start;
        position: relative;
        z-index: 2;
      }
      .hero-tag .ht-dot {
        width: 6px; height: 6px;
        background: var(--gold);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--gold);
        animation: pulse 1.6s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.3); }
      }
      .hero-wordmark {
        font-size: clamp(48px, 5.5vw, 72px);
        color: var(--hydrogen);
        text-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        position: relative;
        z-index: 2;
        margin-bottom: 14px;
      }
      .hero-wordmark .wm-orbit { color: var(--hydrogen); }
      .slogan-zh-headline {
        font-family: "Noto Serif TC", serif;
        font-weight: 600;
        font-size: clamp(18px, 2vw, 26px);
        color: var(--hydrogen);
        line-height: 1.3;
        margin-bottom: 10px;
        letter-spacing: 0.04em;
        position: relative;
        z-index: 2;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
      }
      .slogan-zh-headline em {
        font-family: "Inter", sans-serif;
        font-style: normal;
        font-weight: 800;
        color: var(--gold);
        font-size: 0.92em;
        letter-spacing: -0.02em;
        text-shadow: 0 0 16px rgba(255, 216, 74, 0.6);
        margin: 0 0.05em;
      }
      .slogan-zh-desc {
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 400;
        font-size: 12.5px;
        color: rgba(232, 240, 255, 0.85);
        letter-spacing: 0.08em;
        line-height: 1.65;
        position: relative;
        z-index: 2;
      }
      .slogan-zh-desc .accent { color: var(--gold); font-weight: 500; }
      .slogan-zh-desc .brand {
        font-family: "Inter", sans-serif;
        font-weight: 700;
        color: var(--beacon-bright);
        letter-spacing: -0.01em;
        margin: 0 0.1em;
      }

      .hero-meta {
        margin-top: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }
      .coming-soon {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 11px 20px;
        border: 1px solid var(--beacon);
        border-radius: 8px;
        background: rgba(34, 232, 138, 0.08);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--hydrogen);
      }
      .coming-soon .cs-dot {
        width: 7px; height: 7px;
        background: var(--beacon);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--beacon);
        animation: pulse 1.6s ease-in-out infinite;
      }
      .coming-soon b {
        font-family: "Inter", sans-serif;
        font-weight: 800;
        font-size: 12px;
        letter-spacing: -0.01em;
        text-transform: none;
        color: var(--gold);
        margin: 0 2px;
      }
      .universe-link {
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--hydrogen-dim);
        text-decoration: none;
      }
      .universe-link a {
        color: var(--plasma);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }
      .universe-link a:hover { border-bottom-color: var(--plasma); }

      .player-stack {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 0;
      }

      /* Spotify embed — used as-provided per Spotify Widget Terms.
         Bare iframe sized only; no styling of the iframe content
         (cross-origin anyway). */
      .spotify-embed {
        display: block;
        width: 100%;
        border: 0;
        flex-shrink: 0;
      }

      .noms-frame {
        background: rgba(19, 24, 38, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 216, 74, 0.18);
        border-radius: 16px;
        padding: 18px 20px 16px;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
      .noms-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(232, 240, 255, 0.06);
        gap: 10px;
        flex-shrink: 0;
      }
      .noms-label {
        font-family: "Inter", sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: var(--hydrogen);
        letter-spacing: -0.01em;
      }
      .noms-sublabel {
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 400;
        font-size: 11px;
        color: var(--lunar);
        letter-spacing: 0.05em;
        margin-top: 3px;
      }
      .noms-count {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        color: var(--hydrogen-dim);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        white-space: nowrap;
        padding-top: 2px;
      }
      .noms-count b {
        font-family: "Inter", sans-serif;
        font-weight: 800;
        font-size: 14px;
        color: var(--gold);
        letter-spacing: -0.02em;
        margin-right: 3px;
        text-transform: none;
        text-shadow: 0 0 8px rgba(255, 216, 74, 0.4);
      }

      /* empty state — day-1 launch when no nominations exist */
      .noms-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 30px 24px;
        gap: 12px;
      }
      .noms-empty-glyph {
        width: 56px;
        height: 56px;
        color: var(--beacon);
        margin-bottom: 6px;
        opacity: 0.85;
        animation: emptyGlyphFloat 4s ease-in-out infinite;
        filter: drop-shadow(0 0 18px rgba(34, 232, 138, 0.5));
      }
      @keyframes emptyGlyphFloat {
        0%, 100% { transform: translateY(0) scale(1); opacity: 0.85; }
        50% { transform: translateY(-4px) scale(1.05); opacity: 1; }
      }
      .noms-empty-glyph svg {
        width: 100%; height: 100%;
        display: block;
      }
      .noms-empty-glyph svg ellipse {
        transform-origin: center;
        transform-box: fill-box;
        animation: orbitSpin 9s linear infinite;
      }
      .noms-empty-title {
        font-family: "Noto Serif TC", serif;
        font-weight: 600;
        font-size: 20px;
        color: var(--hydrogen);
        letter-spacing: 0.06em;
        line-height: 1.3;
      }
      .noms-empty-desc {
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 400;
        font-size: 13px;
        color: var(--hydrogen-dim);
        letter-spacing: 0.04em;
        line-height: 1.85;
        max-width: 360px;
      }
      .noms-empty-hint {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding: 8px 16px;
        background: rgba(34, 232, 138, 0.08);
        border: 1px dashed rgba(34, 232, 138, 0.4);
        border-radius: 999px;
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 500;
        font-size: 11.5px;
        color: var(--beacon-bright);
        letter-spacing: 0.05em;
      }
      .noms-empty-hint .emp-arrow {
        color: var(--beacon);
        font-weight: 700;
        animation: empArrowNudge 2.4s ease-in-out infinite;
        display: inline-block;
      }
      @keyframes empArrowNudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(-3px); }
      }

      .signin-prompt {
        background: rgba(10, 13, 20, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(34, 232, 138, 0.35);
        border-radius: 14px;
        padding: 18px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
        flex-shrink: 0;
        box-shadow: 0 0 24px rgba(34, 232, 138, 0.08);
        position: relative;
      }
      .signin-prompt::before {
        content: "";
        position: absolute;
        top: -1px; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--beacon), transparent);
      }
      .signin-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(30, 215, 96, 0.12);
        border: 1px solid rgba(30, 215, 96, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1ED760;
        flex-shrink: 0;
      }
      .signin-icon svg { width: 17px; height: 17px; }
      .signin-body { flex: 1; min-width: 0; }
      .signin-title {
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 600;
        font-size: 13.5px;
        color: var(--hydrogen);
        letter-spacing: 0.02em;
        margin-bottom: 6px;
        line-height: 1.35;
      }
      .signin-desc {
        font-family: "Noto Sans TC", sans-serif;
        font-weight: 400;
        font-size: 11.5px;
        color: var(--hydrogen-dim);
        letter-spacing: 0.04em;
        line-height: 1.65;
        margin-bottom: 12px;
      }
      .signin-desc b {
        color: var(--gold);
        font-weight: 600;
        text-shadow: 0 0 8px rgba(255, 216, 74, 0.3);
      }
      .signin-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        font-family: "Inter", sans-serif;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: -0.005em;
        background: #1ED760;
        color: #000000;
        border: none;
        border-radius: 999px;
        transition: all 0.2s;
        box-shadow: 0 4px 14px rgba(30, 215, 96, 0.3);
      }
      .signin-btn:hover {
        background: #1fdc66;
        transform: translateY(-1px) scale(1.02);
        box-shadow: 0 6px 22px rgba(30, 215, 96, 0.45);
      }
      .signin-btn:active { transform: translateY(0); }
      .signin-btn svg { width: 14px; height: 14px; }

      /* prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        .aurora,
        .card-curtain,
        .twinkle,
        .wordmark .wm-orbit .ring,
        .wordmark .wm-orbit .core,
        .hero-tag .ht-dot,
        .coming-soon .cs-dot,
        .noms-empty-glyph,
        .noms-empty-glyph svg ellipse,
        .noms-empty-hint .emp-arrow {
          animation: none !important;
          transition: none !important;
        }
      }

      /* responsive */
      @media (max-width: 1024px) {
        html, body { overflow-y: auto; overflow-x: hidden; }
        .stage {
          grid-template-columns: 1fr;
          height: auto;
          min-height: 100vh;
          padding: 24px 20px 32px;
          gap: 20px;
        }
        .player-stack { min-height: 0; }
        .noms-frame { max-height: 600px; }
        /* on stacked layout, sign-in is ABOVE the noms — flip the hint arrow */
        .noms-empty-hint .emp-arrow { transform: rotate(90deg); }
      }
      @media (max-width: 700px) {
        .stage { padding: 20px 16px; }
        .wordmark-card { padding: 28px 24px; }
        .noms-frame, .signin-prompt { padding: 14px; }
      }
    </style>
  </body>
</html>
