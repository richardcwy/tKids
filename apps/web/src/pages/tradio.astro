    comment: "阿嬤以前常常哼的歌，獻給她 💛",
    by: "Jasmine",
    avatar: "linear-gradient(135deg, #ff6dba, #5fdec9)",
    votes: 19,
    voted: false,
  },
  {
    cover: "linear-gradient(135deg, #d97757, #ffd84a)",
    title: "Star Walkin'",
    artist: "Lil Nas X",
    comment: "期末考週需要這種能量",
    by: "Kai",
    avatar: "linear-gradient(135deg, #d97757, #ffd84a)",
    votes: 14,
    voted: false,
  },
  {
    cover: "linear-gradient(135deg, #2e5fff, #5b85ff)",
    title: "Sugar Fault",
    artist: "tKids",
    comment: "最愛的一首，等了好久 ✨",
