---
import Layout from "../layouts/Layout.astro";
import AtmosphereBg from "../components/AtmosphereBg.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Your fanclub · tKids"
  description="Your tKids fanclub account."
  noindex={true}
>
  <AtmosphereBg />
  <Nav />

  <main class="dashboard">
    <section id="loading" class="state">
      <p>Loading…</p>
    </section>

    <section id="redirect" class="state" hidden>
      <p>Redirecting to sign in…</p>
    </section>

    <section id="dashboard-content" class="dashboard-content" hidden>
      <header class="dash-head">
        <h1>
          Welcome back<span class="comma">,</span><br />
          <span class="user-name" id="user-name">friend</span>.
        </h1>
        <button id="signout-button" class="signout">Sign out</button>
      </header>

      <div class="cards">
        <article class="card">
          <h2>Your account</h2>
          <dl>
            <dt>Email</dt>
            <dd id="user-email">—</dd>
            <dt>Plan</dt>
            <dd id="plan-name">Free</dd>
          </dl>
        </article>

        <article class="card">
          <h2>EP countdown</h2>
          <p>"Ignite!" · drops <strong>06.01.26</strong> · Taipei time.</p>
          <p>You'll get one email when it's out.</p>
        </article>

        <article class="card">
          <h2>What's coming</h2>
          <ul>
            <li><span lang="zh-TW">EP 首發</span> · launch day stream</li>
            <li>Behind-the-scenes journal</li>
            <li>Fan comments + member messages</li>
          </ul>
          <p class="hint">All Phase 2 — we'll email when each unlocks.</p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { authClient } from "../lib/auth-client";

  const loading = document.getElementById("loading")!;
  const redirect = document.getElementById("redirect")!;
  const content = document.getElementById("dashboard-content")!;
  const userName = document.getElementById("user-name")!;
  const userEmail = document.getElementById("user-email")!;
  const signoutBtn = document.getElementById("signout-button") as HTMLButtonElement;

  async function init() {
    try {
      const { data: session } = await authClient.getSession();

      if (!session?.user) {
        loading.hidden = true;
        redirect.hidden = false;
        window.location.href = "/login";
        return;
      }

      userName.textContent =
        session.user.name ||
        session.user.email?.split("@")[0] ||
        "friend";
      userEmail.textContent = session.user.email ?? "";
      loading.hidden = true;
      content.hidden = false;
    } catch (e) {
      loading.hidden = true;
      redirect.hidden = false;
      window.location.href = "/login";
    }
  }

  signoutBtn?.addEventListener("click", async () => {
    await authClient.signOut({
      fetchOptions: {
        onSuccess: () => {
          window.location.href = "/";
        },
      },
    });
  });

  init();
</script>

<style>
  .dashboard {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 130px 40px 120px;
  }
  .state {
    text-align: center;
    color: var(--ice);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    padding: 80px 20px;
  }

  .dash-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }
  .dash-head h1 {
    font-family: "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--white);
    margin: 0;
  }
  .dash-head h1 .comma {
    color: var(--electric);
  }
  .dash-head h1 .user-name {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
    letter-spacing: -0.01em;
  }
  .signout {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    padding: 10px 20px;
    border: 1px solid rgba(184, 204, 255, 0.3);
    background: transparent;
    color: var(--ice);
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .signout:hover {
    color: var(--white);
    border-color: var(--white);
    background: rgba(255, 255, 255, 0.04);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .card {
    padding: 28px;
    background: rgba(10, 19, 64, 0.55);
    border: 1px solid rgba(184, 204, 255, 0.15);
    border-radius: 18px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 0 40px rgba(46, 95, 255, 0.1);
  }
  .card h2 {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ice);
    margin: 0 0 18px;
  }
  .card p,
  .card li {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--chrome);
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .card strong {
    color: var(--white);
    font-weight: 600;
  }
  .card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .card li::before {
    content: "★ ";
    color: var(--gold);
  }
  .card .hint {
    font-size: 11px;
    color: var(--ice);
    opacity: 0.6;
    margin-top: 14px;
  }

  .card dl {
    margin: 0;
  }
  .card dt {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ice);
    opacity: 0.7;
    margin-top: 14px;
  }
  .card dt:first-child {
    margin-top: 0;
  }
  .card dd {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: var(--white);
    margin: 4px 0 0;
    word-break: break-word;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .cards .card:last-child {
      grid-column: span 2;
    }
  }
  @media (max-width: 600px) {
    .dashboard {
      padding: 110px 20px 100px;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .cards .card:last-child {
      grid-column: span 1;
    }
  }
</style>
