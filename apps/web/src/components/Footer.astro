---
import { useI18n } from "../lib/i18n";
const { t } = useI18n(Astro);

const year = new Date().getFullYear();
const version = __TKIDS_VERSION__;
const commit = __TKIDS_COMMIT__;
const buildDate = __TKIDS_BUILD_DATE__;
/** TODO: replace with the real tKids YouTube channel URL once it exists. */
const YOUTUBE_URL = "#";
---

<footer>
  <div class="ft-left">
    <div>{t("footer.copyright", { year })}</div>
    <div class="fn-tag" lang="zh-TW">點亮宇宙 · ignite the universe</div>
  </div>

  <a
    href={YOUTUBE_URL}
    class="ft-center"
    aria-label={t("footer.youtubeLabel")}
    target={YOUTUBE_URL === "#" ? undefined : "_blank"}
    rel={YOUTUBE_URL === "#" ? undefined : "noopener noreferrer"}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a2.998 2.998 0 0 0-2.107-2.117C19.503 3.5 12 3.5 12 3.5s-7.503 0-9.391.569A2.998 2.998 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a2.998 2.998 0 0 0 2.107 2.117C4.497 20.5 12 20.5 12 20.5s7.503 0 9.391-.569a2.998 2.998 0 0 0 2.107-2.117C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z"/></svg>
    {t("footer.youtubeLabel")}
  </a>

  <div class="ft-right">
    <div class="ft-version" title={`commit ${commit}`}>
      <span class="v-dot" aria-hidden="true"></span>
      <span>
        <b>v{version}</b>
        <span class="ft-commit"> · {commit}</span>
      </span>
    </div>
    <div class="ft-build">
      {t("footer.buildPrefix")} {buildDate} · tkids.tw ·
      <a class="ft-link" href="/privacy">/privacy</a> ·
      <a class="ft-link" href="/terms">/terms</a>
    </div>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 1;
    padding: 36px 40px;
    border-top: 1px solid rgba(184, 204, 255, 0.15);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 30px;
    align-items: center;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ice);
  }

  .ft-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0.75;
  }
  .ft-left .fn-tag {
    font-family: "Noto Sans TC", sans-serif;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: none;
    color: var(--gold);
  }

  .ft-center {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ice);
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid rgba(184, 204, 255, 0.2);
    transition: all 0.2s;
  }
  .ft-center:hover {
    color: var(--white);
    border-color: var(--gold);
    background: rgba(255, 216, 74, 0.08);
  }
  .ft-center svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .ft-right {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
    align-items: flex-end;
  }
  .ft-version {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ice);
    opacity: 0.85;
  }
  .ft-version .v-dot {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 8px #4ade80;
    animation: ftPulse 1.8s ease-in-out infinite;
  }
  @keyframes ftPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(0.85); }
  }
  .ft-version :global(b) {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .ft-version .ft-commit {
    opacity: 0.55;
    letter-spacing: 0.08em;
    text-transform: none;
  }
  .ft-build {
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: var(--ice);
    opacity: 0.5;
  }
  .ft-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .ft-link:hover {
    color: var(--gold);
  }

  @media (max-width: 720px) {
    footer {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 28px 20px;
      gap: 16px;
    }
    .ft-left, .ft-right {
      align-items: center;
      text-align: center;
    }
    .ft-center {
      justify-self: center;
    }
  }
</style>
