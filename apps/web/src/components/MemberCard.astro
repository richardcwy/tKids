---
import type { ImageMetadata } from "astro";

interface Props {
  index: number;
  name: string;
  role: string;
  /** Optional secondary role line (e.g. "team leader" / "隊長"). */
  roleNote?: string;
  auraStyle?: string;
  portrait?: ImageMetadata;
}
const { index, name, role, roleNote, auraStyle, portrait } = Astro.props;
const num = String(index).padStart(2, "0");
---

<article class="member">
  <div class="member-bg"></div>
  <div class="member-aura" style={auraStyle} aria-hidden="true"></div>
  {portrait && (
    <div class="member-portrait" aria-hidden="true">
      <img src={portrait.src} alt="" width="640" height="640" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="member-content">
    <div class="member-top">
      <div class="member-num">{num}<span class="slash">/03</span></div>
      <div class="member-star" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <polygon
            points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"
          ></polygon>
        </svg>
      </div>
    </div>
    <div class="member-bottom">
      <h3 class="member-name">{name}</h3>
      <p class="member-role">{role}</p>
      {roleNote && <p class="member-role-zh">{roleNote}</p>}
    </div>
  </div>
</article>

<style>
  .member {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(184, 204, 255, 0.18);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s;
    isolation: isolate;
  }
  .member:hover {
    transform: translateY(-8px);
    border-color: var(--electric);
  }
  .member-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 80% 60% at 30% 20%, rgba(46, 95, 255, 0.6) 0%, transparent 60%),
      radial-gradient(ellipse 60% 70% at 80% 80%, rgba(17, 34, 128, 0.8) 0%, transparent 65%),
      linear-gradient(165deg, #1a2a80 0%, var(--midnight) 100%);
  }
  .member-aura {
    position: absolute;
    z-index: 2;
    top: 22%;
    left: 18%;
    width: 65%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(30px);
    opacity: 0.7;
    background: radial-gradient(circle, var(--electric) 0%, transparent 70%);
    transition:
      opacity 0.4s,
      transform 0.6s;
  }
  .member:hover .member-aura {
    opacity: 1;
    transform: scale(1.15);
  }
  .member-portrait {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }
  .member-portrait :global(img) {
    width: 100%;
    height: auto;
    max-height: 92%;
    object-fit: contain;
    object-position: bottom center;
    transform: translateY(2%);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.4s;
    filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.45));
  }
  .member:hover .member-portrait :global(img) {
    transform: translateY(0) scale(1.04);
  }
  .member-portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 50%,
      rgba(3, 6, 26, 0.55) 88%,
      rgba(3, 6, 26, 0.85) 100%
    );
    pointer-events: none;
  }
  .member::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    opacity: 0.1;
    mix-blend-mode: overlay;
  }

  .member-content {
    position: relative;
    z-index: 5;
    height: 100%;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .member-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .member-num {
    font-family: "Unbounded", sans-serif;
    font-weight: 800;
    font-size: 44px;
    color: var(--white);
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .slash {
    font-family: "Instrument Serif", serif;
    font-weight: 300;
    color: var(--ice);
    opacity: 0.6;
    margin-left: 2px;
    font-size: 0.6em;
  }
  .member-star {
    width: 28px;
    height: 28px;
    color: var(--gold);
    animation: breathShine 3.5s ease-in-out infinite;
  }
  .member-star :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .member-bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .member-name {
    font-family: "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 5vw, 72px);
    color: var(--white);
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin: 0;
  }
  .member-role {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 17px;
    color: var(--ice);
    line-height: 1.3;
    margin: 0;
  }
  .member-role-zh {
    font-family: "Noto Sans TC", sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: var(--gold);
    letter-spacing: 0.18em;
    margin-top: 4px;
    opacity: 0.9;
  }
</style>
