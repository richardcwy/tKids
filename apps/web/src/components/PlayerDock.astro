---
import Marquee from "./Marquee.astro";
import TeaserBanner from "./TeaserBanner.astro";

// Fixed bottom player. wavesurfer.js (~90KB) is dynamically imported
// ONLY on the first play tap — zero audio-bundle cost at page load.
// Falls back gracefully to a native <audio> element if wavesurfer fails.
interface Props {
  /** Public R2 URL to the teaser AAC. */
  src?: string;
  /** Pre-computed peaks JSON (generated locally via `bun run peaks`). */
  peaks?: string;
  title?: string;
  artist?: string;
}
const {
  src = "/audio/ignite-teaser.m4a",
  peaks = "/audio/ignite-teaser.peaks.json",
  title = "Ignite!",
  artist = "tKids",
} = Astro.props;
---

<div class="player-dock" id="music">
  <TeaserBanner />
  <div class="player-bar" id="playerBar" data-src={src} data-peaks={peaks}>
    <div class="pb-cluster pb-transport">
      <button class="pb-btn pb-prev" aria-label="previous track">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h2v12H6zM9.5 12l8.5 6V6z"/></svg>
      </button>
      <button class="pb-btn pb-play" id="pbPlay" aria-label="play" aria-pressed="false">
        <svg id="pbPlayIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button class="pb-btn pb-next" aria-label="next track">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18l8.5-6L6 6v12zM16 6h2v12h-2z"/></svg>
      </button>
    </div>

    <div class="pb-divider" aria-hidden="true"></div>

    <div class="pb-cluster pb-secondary">
      <button class="pb-btn" id="pbShuffle" aria-label="shuffle" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
      </button>
      <button class="pb-btn" id="pbLoop" aria-label="repeat" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="17 1 21 5 17 9"></polyline>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
          <polyline points="7 23 3 19 7 15"></polyline>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
        </svg>
      </button>
    </div>

    <span class="pb-time-label current" id="pbCur" aria-live="off">0:00</span>

    <div
      class="pb-progress"
      id="pbProgress"
      role="slider"
      tabindex="0"
      aria-label="Seek track"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="0:00 of 0:00"
    >
      <div class="pb-progress-track">
        <div class="pb-progress-fill" id="pbProgressFill"></div>
        <div class="pb-progress-dot" id="pbProgressDot"></div>
      </div>
    </div>

    <span class="pb-time-label" id="pbDur">0:00</span>

    <button class="pb-btn pb-mute" id="pbMute" aria-label="mute" aria-pressed="false">
      <svg id="pbMuteIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
    </button>

    <div class="pb-right">
      <div class="pb-thumb" aria-hidden="true">
        <div class="pb-thumb-star">
          <svg viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>
        </div>
      </div>
      <div class="pb-track-info">
        <span class="pb-artist">{artist}</span>
        <span class="pb-song-title">{title}</span>
      </div>
    </div>
  </div>

  <Marquee />
</div>

<script>
  // Player interactions. Wavesurfer loads ONLY on first play tap so the
  // ~90KB bundle never blocks LCP. Falls back to a bare <audio> if
  // wavesurfer decoding refuses on iOS Safari.
  import type WaveSurferType from "wavesurfer.js";

  const ICON_PLAY = '<path d="M8 5v14l11-7z"/>';
  const ICON_PAUSE = '<path d="M6 4h4v16H6zM14 4h4v16h-4z"/>';
  const ICON_UNMUTED =
    '<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>';
  const ICON_MUTED =
    '<path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zM19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.17v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>';

  const bar = document.getElementById("playerBar") as HTMLElement | null;
  if (bar) {
    const playBtn = document.getElementById("pbPlay") as HTMLButtonElement;
    const playIcon = document.getElementById("pbPlayIcon") as HTMLElement;
    const muteBtn = document.getElementById("pbMute") as HTMLButtonElement;
    const muteIcon = document.getElementById("pbMuteIcon") as HTMLElement;
    const shuffleBtn = document.getElementById("pbShuffle") as HTMLButtonElement;
    const loopBtn = document.getElementById("pbLoop") as HTMLButtonElement;
    const progress = document.getElementById("pbProgress") as HTMLElement;
    const fill = document.getElementById("pbProgressFill") as HTMLElement;
    const dot = document.getElementById("pbProgressDot") as HTMLElement;
    const cur = document.getElementById("pbCur") as HTMLElement;
    const dur = document.getElementById("pbDur") as HTMLElement;

    const src = bar.dataset.src || "";
    const peaksUrl = bar.dataset.peaks || "";

    let ws: InstanceType<typeof WaveSurferType> | null = null;
    let nativeAudio: HTMLAudioElement | null = null;
    let loading = false;

    function fmt(seconds: number): string {
      if (!Number.isFinite(seconds)) return "0:00";
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${String(s).padStart(2, "0")}`;
    }
    function updateProgress(currentSec: number, totalSec: number) {
      const pct = totalSec > 0 ? (currentSec / totalSec) * 100 : 0;
      fill.style.width = `${pct}%`;
      dot.style.left = `${pct}%`;
      cur.textContent = fmt(currentSec);
      dur.textContent = fmt(totalSec);
      progress.setAttribute("aria-valuenow", String(Math.floor(currentSec)));
      progress.setAttribute("aria-valuemax", String(Math.floor(totalSec)));
      progress.setAttribute(
        "aria-valuetext",
        `${fmt(currentSec)} of ${fmt(totalSec)}`,
      );
    }
    function setPlayingIcon(playing: boolean) {
      playIcon.innerHTML = playing ? ICON_PAUSE : ICON_PLAY;
      playBtn.setAttribute("aria-label", playing ? "pause" : "play");
      playBtn.setAttribute("aria-pressed", String(playing));
    }

    async function ensureLoaded(): Promise<boolean> {
      if (ws || nativeAudio) return true;
      if (loading) return false;
      loading = true;
      try {
        const mod = await import("wavesurfer.js");
        const WaveSurfer = mod.default;
        let peaks: number[][] | undefined;
        if (peaksUrl) {
          try {
            const p = await fetch(peaksUrl);
            if (p.ok) peaks = await p.json();
          } catch {
            /* peaks optional */
          }
        }
        ws = WaveSurfer.create({
          container: document.createElement("div"), // hidden; we draw our own UI
          url: src,
          peaks,
          backend: "MediaElement",
          mediaControls: false,
          normalize: true,
        });
        ws.on("audioprocess", () => updateProgress(ws!.getCurrentTime(), ws!.getDuration()));
        ws.on("ready", () => updateProgress(0, ws!.getDuration()));
        ws.on("play", () => setPlayingIcon(true));
        ws.on("pause", () => setPlayingIcon(false));
        ws.on("finish", () => setPlayingIcon(false));
        loading = false;
        return true;
      } catch (e) {
        console.warn(
          "[player] wavesurfer failed, falling back to <audio>:",
          e,
        );
        nativeAudio = new Audio(src);
        nativeAudio.preload = "metadata";
        nativeAudio.addEventListener("timeupdate", () =>
          updateProgress(nativeAudio!.currentTime, nativeAudio!.duration || 0),
        );
        nativeAudio.addEventListener("loadedmetadata", () =>
          updateProgress(0, nativeAudio!.duration || 0),
        );
        nativeAudio.addEventListener("play", () => setPlayingIcon(true));
        nativeAudio.addEventListener("pause", () => setPlayingIcon(false));
        nativeAudio.addEventListener("ended", () => setPlayingIcon(false));
        loading = false;
        return true;
      }
    }

    playBtn.addEventListener("click", async () => {
      const ok = await ensureLoaded();
      if (!ok) return;
      if (ws) {
        if (ws.isPlaying()) ws.pause();
        else ws.play();
      } else if (nativeAudio) {
        if (nativeAudio.paused) nativeAudio.play();
        else nativeAudio.pause();
      }
    });

    muteBtn.addEventListener("click", async () => {
      const ok = await ensureLoaded();
      if (!ok) return;
      const next = ws ? !ws.getMuted() : !nativeAudio!.muted;
      if (ws) ws.setMuted(next);
      if (nativeAudio) nativeAudio.muted = next;
      muteBtn.classList.toggle("muted", next);
      bar.classList.toggle("is-muted", next);
      muteIcon.innerHTML = next ? ICON_MUTED : ICON_UNMUTED;
      muteBtn.setAttribute("aria-label", next ? "unmute" : "mute");
      muteBtn.setAttribute("aria-pressed", String(next));
    });

    [shuffleBtn, loopBtn].forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("aria-pressed") !== "true";
        btn.classList.toggle("is-active", next);
        btn.setAttribute("aria-pressed", String(next));
      });
    });

    // Progress bar: click to seek, keyboard to scrub ±5s, Home/End.
    function seek(ratio: number) {
      const r = Math.max(0, Math.min(1, ratio));
      if (ws) ws.seekTo(r);
      else if (nativeAudio)
        nativeAudio.currentTime = r * (nativeAudio.duration || 0);
    }
    progress.addEventListener("click", async (e) => {
      const ok = await ensureLoaded();
      if (!ok) return;
      const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
      seek((e.clientX - rect.left) / rect.width);
    });
    progress.addEventListener("keydown", async (e) => {
      const ok = await ensureLoaded();
      if (!ok) return;
      const total = ws ? ws.getDuration() : nativeAudio?.duration || 0;
      if (!total) return;
      const cur = ws ? ws.getCurrentTime() : nativeAudio!.currentTime;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        seek((cur - 5) / total);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        seek((cur + 5) / total);
      } else if (e.key === "Home") {
        e.preventDefault();
        seek(0);
      } else if (e.key === "End") {
        e.preventDefault();
        seek(1);
      } else if (e.key === " " || e.key === "Enter") {
        e.preventDefault();
        playBtn.click();
      }
    });
  }
</script>

<style>
  .player-dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
  }
  .player-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 22px;
    /* Solid translucent navy in place of backdrop-filter. backdrop-filter on a
       fixed bottom bar recomputes the blur every scroll frame because the
       content underneath is moving — the #1 mobile-Safari scroll killer.
       The opacity bump from 0.88 → 0.94 keeps the dock feeling distinct
       from the page without paying the per-frame GPU cost. */
    background: rgba(3, 6, 26, 0.94);
    border-top: 1px solid rgba(184, 204, 255, 0.15);
  }
  .pb-cluster {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }
  .pb-divider {
    width: 1px;
    height: 18px;
    background: rgba(184, 204, 255, 0.18);
    flex-shrink: 0;
    margin: 0 4px;
  }
  .pb-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: var(--ice);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.2s,
      background 0.2s,
      transform 0.15s;
    flex-shrink: 0;
  }
  .pb-btn:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.06);
  }
  .pb-btn:active {
    transform: scale(0.92);
  }
  .pb-btn :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
    display: block;
  }
  .pb-btn.is-active {
    color: var(--electric);
  }
  .pb-btn.is-active:hover {
    color: var(--glow);
  }
  .pb-play {
    width: 38px;
    height: 38px;
    background: var(--white);
    color: var(--midnight);
    box-shadow: 0 0 18px rgba(46, 95, 255, 0.35);
  }
  .pb-play:hover {
    background: var(--white);
    color: var(--midnight);
    transform: scale(1.06);
    box-shadow: 0 0 28px rgba(46, 95, 255, 0.55);
  }
  .pb-play :global(svg) {
    width: 14px;
    height: 14px;
  }
  .pb-mute.muted {
    color: var(--gold-warm);
  }

  .pb-time-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--ice);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    opacity: 0.7;
  }
  .pb-time-label.current {
    color: var(--white);
    opacity: 1;
  }

  .pb-progress {
    flex: 1;
    min-width: 0;
    height: 22px;
    display: flex;
    align-items: center;
    cursor: pointer;
    position: relative;
  }
  .pb-progress-track {
    width: 100%;
    height: 2px;
    background: rgba(184, 204, 255, 0.18);
    border-radius: 999px;
    position: relative;
  }
  .pb-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background: linear-gradient(90deg, var(--electric), var(--glow));
    border-radius: 999px;
    box-shadow: 0 0 10px rgba(46, 95, 255, 0.55);
    transition: width 0.12s linear;
  }
  .pb-progress-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--white);
    top: 50%;
    left: 0%;
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 2px var(--electric),
      0 0 14px rgba(46, 95, 255, 0.85);
    transition:
      transform 0.15s,
      left 0.12s linear;
  }
  .pb-progress:hover .pb-progress-dot {
    transform: translate(-50%, -50%) scale(1.2);
  }
  .player-bar.is-muted .pb-progress-fill {
    background: rgba(184, 204, 255, 0.35);
    box-shadow: none;
  }
  .player-bar.is-muted .pb-progress-dot {
    background: var(--ice);
    box-shadow: 0 0 0 2px rgba(184, 204, 255, 0.4);
  }

  .pb-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    min-width: 0;
    max-width: 240px;
  }
  .pb-thumb {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, var(--glow) 0%, transparent 55%),
      linear-gradient(135deg, var(--electric) 0%, var(--navy) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(184, 204, 255, 0.22);
    box-shadow: 0 2px 10px rgba(46, 95, 255, 0.3);
    position: relative;
  }
  .pb-thumb-star {
    width: 15px;
    height: 15px;
    color: var(--gold);
    filter: drop-shadow(0 0 7px rgba(255, 216, 74, 0.65));
    position: relative;
    z-index: 1;
    animation: breathShine 3.5s ease-in-out infinite;
  }
  .pb-thumb-star :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
    display: block;
  }

  .pb-track-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }
  .pb-artist {
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--glow);
    white-space: nowrap;
  }
  .pb-song-title {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--white);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .pb-secondary,
    .pb-divider {
      display: none;
    }
    .player-bar {
      gap: 10px;
      padding: 9px 16px;
    }
  }
  @media (max-width: 600px) {
    .pb-prev,
    .pb-next {
      display: none;
    }
    .pb-right {
      max-width: 130px;
    }
    .pb-artist {
      font-size: 8px;
      letter-spacing: 0.2em;
    }
    .pb-song-title {
      font-size: 12px;
    }
  }
  @media (max-width: 440px) {
    .pb-right {
      max-width: 80px;
    }
    .pb-artist {
      display: none;
    }
    .pb-time-label {
      font-size: 10px;
    }
  }
</style>
