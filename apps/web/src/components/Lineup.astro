---
import MemberCard from "./MemberCard.astro";

const members = [
  {
    index: 1,
    name: "ETHAN",
    role: "lead vocals",
    roleZh: "主唱 · 隊長",
    auraStyle:
      "top: 22%; left: 18%; background: radial-gradient(circle, var(--electric) 0%, transparent 70%);",
  },
  {
    index: 2,
    name: "ALAN",
    role: "rap · producer",
    roleZh: "饒舌 · 製作",
    auraStyle:
      "top: 28%; left: 30%; background: radial-gradient(circle, var(--glow) 0%, transparent 70%);",
  },
  {
    index: 3,
    name: "ALBERT",
    role: "dance · visuals",
    roleZh: "舞蹈 · 視覺",
    auraStyle:
      "top: 20%; left: 25%; background: radial-gradient(circle, #8da7ff 0%, transparent 70%);",
  },
];
---

<section class="frame-two" id="lineup">
  <div class="lineup-head">
    <div>
      <div class="section-label">the lineup</div>
      <h2 class="section-title">three <em>kids</em></h2>
    </div>
    <p class="section-mini">
      Ethan · Alan · Albert
      <small lang="zh-TW">點亮宇宙的三個男孩</small>
    </p>
  </div>

  <div class="members">
    {members.map((m) => <MemberCard {...m} />)}
  </div>

  <div class="lineup-foot">
    <a href="#music" class="cta-btn" id="listen-cta">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
      listen to "Ignite!" · <span lang="zh-TW">聆聽</span>
    </a>
  </div>
</section>

<style>
  .frame-two {
    position: relative;
    z-index: 1;
    padding: 120px 40px;
    overflow: hidden;
  }
  .lineup-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    gap: 30px;
    flex-wrap: wrap;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--ice);
    margin-bottom: 14px;
  }
  .section-label::before {
    content: "";
    width: 40px;
    height: 1px;
    background: var(--electric);
  }
  .section-title {
    font-family: "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(56px, 7.5vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: var(--white);
    margin: 0;
  }
  .section-title em {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
    color: var(--electric);
  }
  .section-mini {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 18px;
    color: var(--ice);
    max-width: 280px;
    text-align: right;
    line-height: 1.35;
    margin: 0;
  }
  .section-mini small {
    display: block;
    font-family: "Noto Sans TC", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 13px;
    color: var(--gold);
    letter-spacing: 0.12em;
    margin-top: 8px;
    opacity: 0.9;
  }

  .members {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .lineup-foot {
    display: flex;
    justify-content: center;
    margin-top: 70px;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    text-decoration: none;
    border: 1px solid var(--white);
    background: var(--white);
    color: var(--midnight);
    border-radius: 999px;
    transition: all 0.3s;
    box-shadow: 0 0 40px rgba(46, 95, 255, 0.3);
  }
  .cta-btn:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--midnight);
    box-shadow: 0 0 60px rgba(255, 216, 74, 0.5);
    transform: translateY(-2px);
  }
  .cta-btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  @media (max-width: 900px) {
    .members {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .members :global(.member:nth-child(3)) {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
    .section-mini {
      text-align: left;
    }
  }
  @media (max-width: 600px) {
    .frame-two {
      padding: 80px 20px;
    }
    .members {
      grid-template-columns: 1fr;
    }
    .members :global(.member:nth-child(3)) {
      grid-column: span 1;
      aspect-ratio: 3 / 4;
    }
  }
</style>
