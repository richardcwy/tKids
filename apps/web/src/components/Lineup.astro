---
import MemberCard from "./MemberCard.astro";
import { useI18n, dictFor } from "../lib/i18n";
import ethanPortrait from "../assets/members/ethan.webp";
import alanPortrait from "../assets/members/alan.webp";
import albertPortrait from "../assets/members/albert.webp";
import mstPortrait from "../assets/members/mst.webp";

const { locale, t } = useI18n(Astro);
const lineupDict = (dictFor(locale) as any).lineup;
const mKey = (key: "ethan" | "alan" | "albert") => lineupDict.members[key];
const guest = lineupDict.guest.mst;

const portraitFor = {
  ethan: ethanPortrait,
  alan: alanPortrait,
  albert: albertPortrait,
};

const members = [
  {
    index: 1,
    slug: "ethan" as const,
    auraStyle:
      "top: 22%; left: 18%; background: radial-gradient(circle, var(--electric) 0%, transparent 70%);",
  },
  {
    index: 2,
    slug: "alan" as const,
    auraStyle:
      "top: 28%; left: 30%; background: radial-gradient(circle, var(--glow) 0%, transparent 70%);",
  },
  {
    index: 3,
    slug: "albert" as const,
    auraStyle:
      "top: 20%; left: 25%; background: radial-gradient(circle, #8da7ff 0%, transparent 70%);",
  },
];
---

<section class="frame-two" id="lineup">
  <div class="lineup-head">
    <div>
      <div class="section-label">{t("lineup.sectionLabel")}</div>
      <h2 class="section-title">{t("lineup.sectionTitlePrefix")} <em>{t("lineup.sectionTitleAccent")}</em></h2>
    </div>
    <p class="section-mini">
      {t("lineup.sectionMini")}
      <small>{t("lineup.sectionMiniSub")}</small>
    </p>
  </div>

  <div class="members">
    {members.map((m) => {
      const mem = mKey(m.slug);
      return (
        <MemberCard
          index={m.index}
          name={mem.name}
          role={mem.role}
          roleNote={mem.roleNote}
          auraStyle={m.auraStyle}
          portrait={portraitFor[m.slug]}
        />
      );
    })}
  </div>

  <div class="guest-block">
    <div class="guest-divider" aria-hidden="true">
      <span class="guest-divider-label">{lineupDict.guestSectionLabel}</span>
    </div>

    <article class="guest" aria-label={`${guest.name} — ${guest.role}`}>
      <div class="guest-bg"></div>
      <div class="guest-aura" aria-hidden="true"></div>

      <div class="guest-stage" aria-hidden="true"></div>
      <div class="guest-portrait" aria-hidden="true">
        <img src={mstPortrait.src} alt="" width="640" height="640" loading="lazy" decoding="async" />
      </div>

      <div class="guest-content">
        <div class="guest-top">
          <div class="guest-tag">{lineupDict.guestSectionLabel}</div>
          <div class="guest-star" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon>
            </svg>
          </div>
        </div>

        <div class="guest-bottom">
          <h3 class="guest-name">{guest.name}</h3>
          <p class="guest-role">{guest.role}</p>
          {guest.roleNote && <p class="guest-rolenote">{guest.roleNote}</p>}
          <p class="guest-tagline" lang={locale === "zh-TW" ? "zh-TW" : undefined}>
            {lineupDict.guestSectionMini}
          </p>
        </div>
      </div>
    </article>
  </div>

  <div class="lineup-foot">
    <a href="#music" class="cta-btn" id="listen-cta">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
      {t("lineup.ctaListen")}
    </a>
  </div>
</section>

<style>
  .frame-two {
    position: relative;
    z-index: 1;
    padding: 120px 40px;
    overflow: hidden;
  }
  .lineup-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    gap: 30px;
    flex-wrap: wrap;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--ice);
    margin-bottom: 14px;
  }
  .section-label::before {
    content: "";
    width: 40px;
    height: 1px;
    background: var(--electric);
  }
  .section-title {
    font-family: "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(56px, 7.5vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: var(--white);
    margin: 0;
  }
  .section-title em {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
    color: var(--electric);
  }
  .section-mini {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 18px;
    color: var(--ice);
    max-width: 280px;
    text-align: right;
    line-height: 1.35;
    margin: 0;
  }
  .section-mini small {
    display: block;
    font-family: "Noto Sans TC", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 13px;
    color: var(--gold);
    letter-spacing: 0.12em;
    margin-top: 8px;
    opacity: 0.9;
  }

  .members {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .guest-block {
    max-width: 1400px;
    margin: 80px auto 0;
  }
  .guest-divider {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
  }
  .guest-divider::before,
  .guest-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 216, 74, 0.35) 50%,
      transparent 100%
    );
  }
  .guest-divider-label {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-shadow: 0 0 14px rgba(255, 216, 74, 0.35);
  }

  .guest {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 216, 74, 0.32);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s,
      box-shadow 0.3s;
    isolation: isolate;
    min-height: 280px;
    box-shadow: 0 0 60px rgba(255, 216, 74, 0.08);
  }
  .guest:hover {
    transform: translateY(-6px);
    border-color: var(--gold);
    box-shadow: 0 0 90px rgba(255, 216, 74, 0.18);
  }
  .guest-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 70% 80% at 80% 30%, rgba(255, 216, 74, 0.18) 0%, transparent 60%),
      radial-gradient(ellipse 60% 70% at 20% 80%, rgba(46, 95, 255, 0.35) 0%, transparent 65%),
      linear-gradient(135deg, #15205c 0%, var(--midnight) 100%);
  }
  .guest-aura {
    position: absolute;
    z-index: 2;
    top: 10%;
    right: 8%;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    background: radial-gradient(circle, var(--gold) 0%, transparent 70%);
    transition: opacity 0.4s, transform 0.6s;
  }
  .guest:hover .guest-aura {
    opacity: 0.85;
    transform: scale(1.15);
  }
  .guest::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    opacity: 0.1;
    mix-blend-mode: overlay;
  }

  /* Stage backing for Ms.T — same idea as MemberCard.member-stage, sized
     for the guest portrait column. Lifts dark figures off the navy. */
  .guest-stage {
    position: absolute;
    z-index: 2;
    top: 4%;
    right: 0;
    bottom: 4%;
    width: 32%;
    pointer-events: none;
    background: radial-gradient(
      ellipse 75% 70% at 60% 40%,
      rgba(255, 216, 74, 0.2) 0%,
      rgba(255, 216, 74, 0.07) 35%,
      transparent 70%
    );
    filter: blur(20px);
    opacity: 0.9;
    transition: opacity 0.4s;
  }
  .guest:hover .guest-stage {
    opacity: 1;
  }
  .guest-portrait {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    bottom: 0;
    width: 32%;
    pointer-events: none;
    overflow: hidden;
  }
  .guest-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    transform: scale(1.02);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    filter:
      drop-shadow(0 24px 48px rgba(0, 0, 0, 0.55))
      drop-shadow(0 0 14px rgba(255, 216, 74, 0.18));
  }
  .guest:hover .guest-portrait :global(img) {
    transform: scale(1.06);
  }
  .guest-portrait::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(3, 6, 26, 0.85) 0%,
      rgba(3, 6, 26, 0.35) 30%,
      transparent 65%
    );
    pointer-events: none;
    z-index: 1;
  }

  .guest-content {
    position: relative;
    z-index: 5;
    height: 100%;
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    max-width: 68%;
  }
  .guest-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .guest-tag {
    display: inline-block;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--gold);
    padding: 5px 12px;
    border: 1px solid rgba(255, 216, 74, 0.4);
    border-radius: 999px;
  }
  .guest-star {
    width: 36px;
    height: 36px;
    color: var(--gold);
    animation: breathShine 3.5s ease-in-out infinite;
  }
  .guest-star :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .guest-bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .guest-name {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(56px, 8vw, 120px);
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }
  .guest-role {
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gold);
    margin: 8px 0 0;
  }
  .guest-rolenote {
    font-family: "Noto Sans TC", sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: var(--ice);
    letter-spacing: 0.15em;
    margin: 4px 0 0;
    opacity: 0.85;
  }
  .guest-tagline {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 16px;
    color: var(--ice);
    margin: 14px 0 0;
    opacity: 0.9;
  }

  .lineup-foot {
    display: flex;
    justify-content: center;
    margin-top: 70px;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    font-family: "Unbounded", sans-serif;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    text-decoration: none;
    border: 1px solid var(--white);
    background: var(--white);
    color: var(--midnight);
    border-radius: 999px;
    transition: all 0.3s;
    box-shadow: 0 0 40px rgba(46, 95, 255, 0.3);
  }
  .cta-btn:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--midnight);
    box-shadow: 0 0 60px rgba(255, 216, 74, 0.5);
    transform: translateY(-2px);
  }
  .cta-btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  @media (max-width: 900px) {
    .members {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .members :global(.member:nth-child(3)) {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
    .section-mini {
      text-align: left;
    }
  }
  @media (max-width: 600px) {
    .frame-two {
      padding: 80px 20px;
    }
    .members {
      grid-template-columns: 1fr;
    }
    .members :global(.member:nth-child(3)) {
      grid-column: span 1;
      aspect-ratio: 3 / 4;
    }
    .guest-block {
      margin-top: 60px;
    }
    /* On mobile the card stacks: portrait on top, text underneath. The
       absolute-positioned right-column from desktop becomes a normal-flow
       block at the top of the card. */
    .guest {
      min-height: 0;
    }
    .guest-stage {
      position: relative;
      width: 100%;
      height: 280px;
      top: auto;
      right: auto;
      bottom: auto;
    }
    .guest-portrait {
      position: relative;
      width: 100%;
      height: 280px;
      inset: auto;
      margin-top: -280px;
    }
    .guest-portrait :global(img) {
      object-position: center 22%;
    }
    .guest-portrait::before {
      background: linear-gradient(
        180deg,
        transparent 0%,
        transparent 55%,
        rgba(3, 6, 26, 0.6) 85%,
        rgba(3, 6, 26, 0.95) 100%
      );
    }
    .guest-content {
      padding: 22px 22px 26px;
      gap: 18px;
      max-width: 100%;
    }
    .guest-aura {
      width: 200px;
      height: 200px;
      filter: blur(50px);
      top: 30px;
      right: 30px;
    }
    .guest-name {
      font-size: clamp(48px, 13vw, 88px);
    }
  }
</style>
