---
// Multilingual ticker at the bottom of the dock. Covers EN / zh-TW /
// ja / ko / fr / it / es / de. CJK items get `lang-*` classes so the
// right Noto subset is used instead of falling back to Latin metrics.
// Duplicated inline so the -50% translate looks seamless.

const items = [
  { text: "IGNITE!" },
  { text: "點亮宇宙", cls: "lang-zh" },
  { text: "enflamme l'univers" },
  { text: "宇宙を灯せ", cls: "lang-ja" },
  { text: "shine through the night" },
  { text: "accendi l'universo" },
  { text: "우주를 밝혀라", cls: "lang-ko" },
  { text: "world tour" },
  { text: "因星芒而閃亮", cls: "lang-zh" },
  { text: "Entzünde das Universum" },
  { text: "星の光で輝く", cls: "lang-ja" },
  { text: "enciende el universo" },
  { text: "tKids" },
  { text: "brille dans la nuit" },
  { text: "월드투어", cls: "lang-ko" },
  { text: "世界巡演", cls: "lang-zh" },
  { text: "tournée mondiale" },
  { text: "ワールドツアー", cls: "lang-ja" },
  { text: "gira mundial" },
  { text: "Welttournee" },
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {items.map((item) => (
      <>
        <span class={item.cls}>{item.text}</span>
        <span class="sep">★</span>
      </>
    ))}
    {items.map((item) => (
      <>
        <span class={item.cls}>{item.text}</span>
        <span class="sep">★</span>
      </>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    background: var(--electric);
    color: var(--white);
    overflow: hidden;
    padding: 14px 0;
  }
  .marquee-track {
    display: flex;
    gap: 40px;
    white-space: nowrap;
    animation: slide 70s linear infinite;
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .marquee-track :global(.lang-zh) {
    font-family: "Noto Sans TC", sans-serif;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .marquee-track :global(.lang-ja) {
    font-family: "Noto Sans JP", "Noto Sans TC", sans-serif;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .marquee-track :global(.lang-ko) {
    font-family: "Noto Sans KR", "Noto Sans JP", "Noto Sans TC", sans-serif;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .marquee-track .sep {
    font-family: "Unbounded", sans-serif;
    color: var(--gold);
  }

  @media (max-width: 600px) {
    .marquee-track {
      font-size: 18px;
      gap: 28px;
    }
  }
</style>
